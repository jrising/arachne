>                                                                  tags$a("Technical Docs", href="www/PROSPER_Technical_Documentation.pdf", target="_blank")))),
>                                  data.frame(Title="New Insights on Physical Climate Risk and Adaptation Assessment in Scenario Analysis and Stress Testing",
>                                             Type="Policy Brief", Released="July 2026",
>                                             Links="In Preparation"),
