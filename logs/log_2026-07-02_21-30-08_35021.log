>         cut       = split_point,
>         mean_y    = fr[left_node, "yval"]
>       ),
>       right = list(
>         variable  = split_var,
>         condition = paste0(split_var, " >= ", format(split_point, digits = 6)),
>         cut       = split_point,
>         mean_y    = fr[right_node, "yval"]
>       )
>     )
>     
>   } else {
>     ## ---------- factor split ----------
>     levs <- xl[[split_var]]
>     if (is.null(levs)) {
>       stop("No xlevels found for factor variable '", split_var, "'.")
>     }
>     
>     # row index into csplit
>     cs_row <- cs[index, ]
>     # -1 = left, 1 = right, 2 = neither (for ordered / 3-way)
>     left_levels  <- levs[cs_row == -1]
>     right_levels <- levs[cs_row ==  1]
>     
>     list(
>       variable = split_var,
>       left = list(
>         variable  = split_var,
>         condition = paste0(split_var, " ∈ {", paste(left_levels, collapse = ", "), "}"),
>         levels    = left_levels,
>         mean_y    = fr[left_node, "yval"]
>       ),
>       right = list(
>         variable  = split_var,
>         condition = paste0(split_var, " ∈ {", paste(right_levels, collapse = ", "), "}"),
>         levels    = right_levels,
>         mean_y    = fr[right_node, "yval"]
>       )
>     )
>   }
> }
> ```
> 
> And a convenience wrapper for a data‑frame output:
> 
> ```r
> first_split_df <- function(mod) {
>   x <- get_first_split_groups(mod)
>   data.frame(
>     variable        = x$variable,
>     left.condition  = x$left$condition,
>     left.value      = x$left$mean_y,
>     right.condition = x$right$condition,
>     right.value     = x$right$mean_y,
>     stringsAsFactors = FALSE
>   )
> }
> ```
> 
> ---
> 
> ## Debugging one problematic case
> 
> For one country where you see the error, run these and paste the outputs if it still fails:
> 
> ```r
> print(mod)
> str(mod$frame)
> mod$splits
> mod$csplit
> attr(mod, "xlevels")
> ```
> 
> That will expose exactly how `rpart` is encoding the split on `persist` for that case, and we can then adapt precisely. But in most standard uses, the combination of:
> 
> - forcing `persist` numeric before fitting, and
> - using `xl[[split_var]]` to detect factor vs numeric
> 
> eliminates the `"No xlevels found for factor variable 'persist'"` problem.
**user**:
> I don't think the factor logic
>     cs_row <- cs[index, ]
>     # Coding: -1 = left, 1 = right, 2 = not used / middle
>     left_levels  <- levs[cs_row == -1]
>     right_levels <- levs[cs_row ==  1]
