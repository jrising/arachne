> It returns the two child nodes of the root, with a description of what “left” and “right” mean and their average `y` values.
> 
> ```r
> library(rpart)
> 
> get_first_split_groups <- function(mod) {
>   fr <- mod$frame
>   
>   # root node is always first row
>   root_row <- fr[1, ]
>   split_var <- as.character(root_row$var)
>   if (split_var == "<leaf>") {
>     stop("Tree has no splits: root is a leaf.")
>   }
>   
>   # children of root: in rpart's binary numbering, 2 = left, 3 = right
>   left_node  <- rownames(fr)[2]
>   right_node <- rownames(fr)[3]
>   
>   # --- figure out how the variable is split ---
>   # 'splits' matrix has one row per split, named by variable
>   s <- mod$splits[split_var, ]
>   
>   # for factor splits, s["ncat"] is non‑zero
>   # for numeric splits, s["ncat"] = 0 and 'index' is the cutpoint
>   ncat  <- as.integer(s["ncat"])
>   index <- as.numeric(s["index"])
>   
>   if (ncat == 0) {
>     ## ---------------- numeric / ordered split ----------------
>     # For numeric predictors, 'index' is the split point
>     split_point <- index
>     
>     left_desc  <- paste0(split_var, " < ",  format(split_point, digits = 6))
>     right_desc <- paste0(split_var, " >= ", format(split_point, digits = 6))
>     
>     left_info <- list(
>       condition = left_desc,
>       mean_y    = fr[left_node,  "yval"]
>     )
>     right_info <- list(
>       condition = right_desc,
>       mean_y    = fr[right_node, "yval"]
>     )
>     
>   } else {
>     ## ---------------- factor split ----------------
>     # Levels of the splitting variable (in rpart's internal order)
>     levs <- attr(mod, "xlevels")[[split_var]]
>     if (is.null(levs)) {
>       stop("No xlevels found for factor variable '", split_var, "'.")
>     }
>     
>     k <- abs(ncat)
>     # 'index' encodes which levels go to the left via its bits
>     bits <- as.integer(intToBits(as.integer(index)))[seq_len(k)]
>     
>     left_levels  <- levs[bits == 1]
>     right_levels <- levs[bits == 0]
>     
>     left_info <- list(
>       condition = paste0(split_var, " ∈ {", paste(left_levels, collapse = ", "), "}"),
>       levels    = left_levels,
>       mean_y    = fr[left_node,  "yval"]
>     )
>     right_info <- list(
>       condition = paste0(split_var, " ∈ {", paste(right_levels, collapse = ", "), "}"),
>       levels    = right_levels,
>       mean_y    = fr[right_node, "yval"]
>     )
>   }
>   
>   list(
>     variable = split_var,
>     left  = left_info,
>     right = right_info
>   )
> }
> ```
