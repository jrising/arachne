**assistant**:
> You can pull this directly from the `rpart` object without parsing the printed tree. The information you want is in `mod$splits` and `mod$frame`.
> 
> For a categorical split (like `trade.method`), `mod$splits["trade.method", ]` will have:
> 
> - `index`: a bitmask describing which factor levels go to the left child  
> - `ncat`: number of levels (with sign indicating ordered/unordered)  
> 
> The left and right child nodes are nodes 2 and 3 in `mod$frame` (for the first split).
> 
> Here’s a compact function that returns the two sides of the first split, with their levels and mean `y` values:
> 
> ```r
> library(rpart)
> 
> get_first_split_groups <- function(mod) {
>   fr <- mod$frame
>   
>   # node 1 is root
>   root_row <- fr[1, ]
>   var <- as.character(root_row$var)
>   
>   # handle only categorical splits here
>   if (!is.factor(mod$frame$yval2[, 1]) && is.null(attr(mod, "xlevels")[[var]])) {
>     stop("This helper currently assumes 'var' is a factor with xlevels recorded in the model.")
>   }
>   
>   # all levels of the splitting variable, in the order rpart uses
>   levs <- attr(mod, "xlevels")[[var]]
>   
>   # split description for that variable
>   s <- mod$splits[var, ]
>   ncat <- as.integer(s["ncat"])
>   index <- as.integer(s["index"])
>   
>   # for unordered factors, |ncat| is #levels, and index encodes a partition:
>   # left group = levels where corresponding bit in index is 1
>   # right group = the rest
>   k <- abs(ncat)
>   bits <- as.integer(intToBits(index))[seq_len(k)]
>   left_levels  <- levs[bits == 1]
>   right_levels <- levs[bits == 0]
>   
>   # children of root: by rpart's convention: left node = 2, right node = 3
>   left_node  <- rownames(fr)[2]
>   right_node <- rownames(fr)[3]
>   
>   list(
>     variable = var,
>     left = list(
>       levels  = left_levels,
>       mean_y  = fr[left_node, "yval"]
>     ),
>     right = list(
>       levels  = right_levels,
>       mean_y  = fr[right_node, "yval"]
>     )
>   )
> }
> ```
> 
> Applied to your model:
> 
> ```r
> res <- get_first_split_groups(mod)
> res
> ```
> 
> You’d get something like:
> 
> ```r
> $variable
> [1] "trade.method"
> 
> $left
> $left$levels
> [1] "li"
> $left$mean_y
> [1] -0.2241768
> 
> $right
> $right$levels
> [1] "dd"   "fd"   "none"
> $right$mean_y
> [1] -0.01063457
> ```
> 
> If you want a simple data frame instead:
> 
> ```r
> first_split_df <- function(mod) {
>   x <- get_first_split_groups(mod)
>   data.frame(
>     side   = c("left", "right"),
>     levels = c(paste(x$left$levels,  collapse = ","),
>                paste(x$right$levels, collapse = ",")),
>     mean_y = c(x$left$mean_y, x$right$mean_y),
>     variable = x$variable,
>     stringsAsFactors = FALSE
>   )
> }
> 
> first_split_df(mod)
> ```
> 
