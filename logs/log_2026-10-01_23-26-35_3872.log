>     def _sample_softmax(
>         self,
>         context: PlannerContext,
>         scored: Sequence[tuple[PlanSpec, float]],
>     ) -> PlanSpec:
>         maximum = max(score for _, score in scored)
>         weights = [
>             math.exp((score - maximum) / self.temperature) for _, score in scored
>         ]
>         total = sum(weights)
>         rng = self._deterministic_rng(context, scored)
>         threshold = rng.random() * total
> 
>         cumulative = 0.0
>         for (plan, _), weight in zip(scored, weights):
>             cumulative += weight
>             if cumulative >= threshold:
>                 return plan
>         return scored[-1][0]
> 
>     def _deterministic_rng(
>         self,
>         context: PlannerContext,
>         scored: Sequence[tuple[PlanSpec, float]],
>     ) -> random.Random:
>         material = repr(
>             (
>                 self.random_seed,
>                 self._revision,
>                 context.user_id_for_memory,
>                 context.current_timestamp,
>                 context.task_class,
>                 context.risk_level,
>                 [(p.plan_id, p.version, round(score, 12)) for p, score in scored],
>             )
>         )
>         seed = int.from_bytes(hashlib.sha256(material.encode()).digest()[:8], "big")
>         return random.Random(seed)
