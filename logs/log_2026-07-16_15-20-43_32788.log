> ## Backend protocols / adapters
> 
> ```python
> class TextGenerationBackend(Protocol):
>     def single_prompt(self, text: str) -> str:
>         ...
> 
>     def chat_response(self, messages: list[dict[str, str]]) -> str:
>         ...
> ```
> 
> ### Wrapper backend
> 
> ```python
> class ChatWrapBackend:
>     """
>     Adapter for your existing chatwrap interface.
> 
>     Expected methods:
>     - chatwrap.single_prompt(text) -> str
>     - chatwrap.chat_response(messages) -> str
>     """
> 
>     def __init__(self, chatwrap: Any) -> None:
>         self.chatwrap = chatwrap
> 
>     def single_prompt(self, text: str) -> str:
>         return self.chatwrap.single_prompt(text)
> 
>     def chat_response(self, messages: list[dict[str, str]]) -> str:
>         return self.chatwrap.chat_response(messages)
> ```
> 
> ### Direct OpenAI backend
> 
> This assumes a compatible client. Since the exact SDK may vary in your codebase, I’ll keep it close to your example.
> 
> ```python
> class DirectOpenAIBackend:
>     """
>     Thin adapter around direct OpenAI chat completion calls.
> 
>     Expects an object with:
>         openai.ChatCompletion.create(...)
>     or compatible behavior.
>     """
> 
>     def __init__(
>         self,
>         openai_module: Any,
>         *,
>         model_name: str = "gpt-4o-mini",
>         temperature: float = 0.0,
>         max_tokens: int = 800,
>     ) -> None:
>         self.openai_module = openai_module
>         self.model_name = model_name
>         self.temperature = temperature
>         self.max_tokens = max_tokens
> 
>     def single_prompt(self, text: str) -> str:
>         messages = [{"role": "user", "content": text}]
>         return self.chat_response(messages)
> 
>     def chat_response(self, messages: list[dict[str, str]]) -> str:
>         response = self.openai_module.ChatCompletion.create(
>             model=self.model_name,
>             messages=messages,
>             max_tokens=self.max_tokens,
>             temperature=self.temperature,
>         )
>         return response["choices"][0]["message"]["content"]
> ```
> 
> ### Selector backend
> 
> This is for your BayesSelector-like object.
> 
> ```python
> class SelectorBackend:
>     """
>     Adapter for an object exposing:
>     - selector.chat_response(messages) -> str
>     - optionally selector.single_prompt(text) -> str
>     """
> 
>     def __init__(self, selector: Any) -> None:
>         self.selector = selector
> 
>     def single_prompt(self, text: str) -> str:
>         if hasattr(self.selector, "single_prompt"):
>             return self.selector.single_prompt(text)
>         return self.selector.chat_response([{"role": "user", "content": text}])
> 
>     def chat_response(self, messages: list[dict[str, str]]) -> str:
>         return self.selector.chat_response(messages)
> ```
