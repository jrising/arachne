> """
> Shared, version-aware registry for models, tools, plans, and plan templates.
> 
> Registry entries are registered once and then referenced by stable IDs and
> versions. The registry contains capability metadata; it does not execute
> providers and does not decide which plan to use.
> """
> 
> from __future__ import annotations
> 
> from dataclasses import dataclass
> from threading import RLock
> from types import MappingProxyType
> from typing import Any, Callable, Mapping, Protocol
> 
> from .types import ModelSpec, PlanSpec, PlannerContext, ToolConfig, ToolSpec
> 
> 
> class ModelAdapter(Protocol):
>     """Minimum model-adapter surface required by registered models."""
> 
>     def chat_response(
>         self,
>         messages: list[Mapping[str, Any]],
>         max_tokens: int | None = None,
>     ) -> str: ...
> 
>     def stream_response(
>         self,
>         messages: list[Mapping[str, Any]],
>         max_tokens: int | None = None,
>     ): ...
> 
>     def allowed(self, tokens: int) -> bool: ...
> 
> 
> @dataclass(frozen=True)
> class RegisteredModel:
>     """A versioned model specification plus its local provider adapter."""
> 
>     spec: ModelSpec
>     adapter: ModelAdapter
> 
> 
> @dataclass(frozen=True)
> class RegisteredTool:
>     """A versioned tool specification plus its executable callable."""
> 
>     spec: ToolSpec
>     fn: Callable[..., Any]
> 
> 
> class Registry:
>     """
>     Thread-safe in-process registry.
> 
>     Registration is idempotent for materially equivalent entries. Reusing an
>     existing ID/version with different capability metadata or executable
>     bindings raises ValueError unless `overwrite=True` is explicitly supplied.
>     """
> 
>     def __init__(self) -> None:
>         self._models: dict[tuple[str, str], RegisteredModel] = {}
>         self._tools: dict[tuple[str, str], RegisteredTool] = {}
>         self._plans: dict[tuple[str, str], PlanSpec] = {}
> 
>         # Explicit latest pointers avoid incorrect lexical version sorting.
>         self._latest_model_versions: dict[str, str] = {}
>         self._latest_tool_versions: dict[str, str] = {}
>         self._latest_plan_versions: dict[str, str] = {}
> 
>         self._lock = RLock()
> 
>     def register_model(
>         self,
>         adapter: ModelAdapter,
>         *,
>         model_id: str,
>         cost_per_million_tokens: float | None = None,
>         quality_prior: float | None = None,
>         version: str = "1",
>         metadata: Mapping[str, Any] | None = None,
>         overwrite: bool = False,
>     ) -> ModelSpec:
>         self._require_identifier(model_id, "model_id")
>         self._require_identifier(version, "version")
>         self._validate_prior(quality_prior, "quality_prior")
>         self._validate_nonnegative(cost_per_million_tokens, "cost_per_million_tokens")
> 
>         adapter_id = str(
>             getattr(adapter, "adapter_id", None)
>             or getattr(adapter, "id", None)
>             or adapter.__class__.__qualname__
>         )
>         spec = ModelSpec(
>             model_id=model_id,
>             adapter_id=adapter_id,
>             version=version,
>             cost_per_million_tokens=cost_per_million_tokens,
>             quality_prior=quality_prior,
>             metadata=self._frozen_mapping(metadata),
>         )
>         entry = RegisteredModel(spec=spec, adapter=adapter)
> 
>         with self._lock:
>             self._register_versioned(
>                 store=self._models,
>                 latest=self._latest_model_versions,
>                 key=(model_id, version),
>                 value=entry,
>                 equivalent=lambda old, new: (
>                     old.spec == new.spec and old.adapter is new.adapter
>                 ),
>                 overwrite=overwrite,
>                 kind="model",
>             )
>         return spec
> 
>     def register_tool(
>         self,
>         *,
>         name: str,
>         description: str,
>         fn: Callable[..., Any],
>         config: ToolConfig | Mapping[str, Any] | None = None,
>         quality_prior: float | None = None,
>         cost_estimate: float | None = None,
>         version: str = "1",
>         metadata: Mapping[str, Any] | None = None,
>         overwrite: bool = False,
>     ) -> ToolSpec:
>         self._require_identifier(name, "name")
>         self._require_identifier(version, "version")
>         if not description.strip():
>             raise ValueError("Tool description must not be empty.")
>         if not callable(fn):
>             raise TypeError("Tool fn must be callable.")
> 
>         self._validate_prior(quality_prior, "quality_prior")
>         self._validate_nonnegative(cost_estimate, "cost_estimate")
>         tool_config = self._coerce_tool_config(config)
> 
>         spec = ToolSpec(
>             name=name,
>             description=description,
>             version=version,
>             config=tool_config,
>             quality_prior=quality_prior,
>             cost_estimate=cost_estimate,
>             metadata=self._frozen_mapping(metadata),
>         )
>         entry = RegisteredTool(spec=spec, fn=fn)
> 
>         with self._lock:
>             self._register_versioned(
>                 store=self._tools,
>                 latest=self._latest_tool_versions,
>                 key=(name, version),
>                 value=entry,
>                 equivalent=lambda old, new: old.spec == new.spec and old.fn is new.fn,
>                 overwrite=overwrite,
>                 kind="tool",
>             )
>         return spec
> 
>     def register_plan(self, plan: PlanSpec, *, overwrite: bool = False) -> PlanSpec:
>         self._require_identifier(plan.plan_id, "plan_id")
>         self._require_identifier(plan.version, "version")
> 
>         with self._lock:
>             self._validate_plan_references(plan)
>             self._register_versioned(
>                 store=self._plans,
>                 latest=self._latest_plan_versions,
>                 key=(plan.plan_id, plan.version),
>                 value=plan,
>                 equivalent=lambda old, new: old == new,
>                 overwrite=overwrite,
>                 kind="plan",
>             )
>         return plan
> 
>     def get_model(
>         self, model_id: str, version: str | None = None
>     ) -> RegisteredModel:
>         return self._get(
>             self._models,
>             self._latest_model_versions,
>             model_id,
>             version,
>             "model",
>         )
> 
>     def get_model_spec(self, model_id: str, version: str | None = None) -> ModelSpec:
>         return self.get_model(model_id, version).spec
> 
>     def get_tool(self, name: str, version: str | None = None) -> RegisteredTool:
>         return self._get(
>             self._tools,
>             self._latest_tool_versions,
>             name,
>             version,
>             "tool",
>         )
> 
>     def get_tool_spec(self, name: str, version: str | None = None) -> ToolSpec:
>         return self.get_tool(name, version).spec
> 
>     def get_plan(self, plan_id: str, version: str | None = None) -> PlanSpec:
>         return self._get(
>             self._plans,
>             self._latest_plan_versions,
>             plan_id,
>             version,
>             "plan",
>         )
> 
>     def eligible_plans(
>         self,
>         context: PlannerContext | None = None,
>     ) -> list[PlanSpec]:
>         """
>         Return registered plans whose declared static constraints fit context.
> 
>         Supported optional plan metadata:
>         - ``enabled``: bool, default True
>         - ``task_classes``: sequence[str]
>         - ``risk_levels``: sequence[str]
> 
>         Dynamic provider availability remains the responder/selection layer's
>         responsibility because it can depend on token counts and live quotas.
>         """
>         with self._lock:
>             plans = list(self._plans.values())
> 
>         return [
>             plan
>             for plan in plans
>             if self._plan_matches_context(plan, context)
>         ]
> 
>     def list_models(self) -> list[ModelSpec]:
>         with self._lock:
>             return [entry.spec for entry in self._models.values()]
> 
>     def list_tools(self) -> list[ToolSpec]:
>         with self._lock:
>             return [entry.spec for entry in self._tools.values()]
> 
>     def list_plans(self) -> list[PlanSpec]:
>         with self._lock:
>             return list(self._plans.values())
> 
>     def _validate_plan_references(self, plan: PlanSpec) -> None:
>         if plan.model_id is not None and plan.model_id not in self._latest_model_versions:
>             raise KeyError(f"Plan references unregistered model: {plan.model_id!r}")
> 
>         for binding in plan.tool_bindings:
>             key = (binding.tool_name, binding.tool_version)
>             if key not in self._tools:
>                 raise KeyError(
>                     "Plan references unregistered tool version: "
>                     f"{binding.tool_name!r}@{binding.tool_version!r}"
>                 )
> 
>     @staticmethod
>     def _plan_matches_context(
>         plan: PlanSpec,
>         context: PlannerContext | None,
>     ) -> bool:
>         metadata = plan.metadata
>         if metadata.get("enabled", True) is False:
>             return False
>         if context is None:
>             return True
> 
>         task_classes = metadata.get("task_classes")
>         if task_classes and context.task_class not in task_classes:
>             return False
> 
>         risk_levels = metadata.get("risk_levels")
>         return not (risk_levels and context.risk_level not in risk_levels)
> 
>     @staticmethod
>     def _coerce_tool_config(
>         config: ToolConfig | Mapping[str, Any] | None,
>     ) -> ToolConfig:
>         if config is None:
>             return ToolConfig()
>         if isinstance(config, ToolConfig):
>             return config
>         if not isinstance(config, Mapping):
>             raise TypeError("Tool config must be a ToolConfig or mapping.")
> 
>         # Accept the documented {"defaults": ..., "options": ...} form.
>         if "defaults" in config or "options" in config or "version" in config:
>             return ToolConfig(
>                 defaults=dict(config.get("defaults", {})),
>                 options=dict(config.get("options", {})),
>                 version=str(config.get("version", "1")),
>             )
> 
>         # Convenience form: plain mapping is interpreted as defaults.
>         return ToolConfig(defaults=dict(config))
> 
>     @staticmethod
>     def _register_versioned(
>         *,
>         store: dict[tuple[str, str], Any],
>         latest: dict[str, str],
>         key: tuple[str, str],
>         value: Any,
>         equivalent: Callable[[Any, Any], bool],
>         overwrite: bool,
>         kind: str,
>     ) -> None:
>         existing = store.get(key)
>         if existing is not None and not equivalent(existing, value) and not overwrite:
>             raise ValueError(
>                 f"Cannot replace registered {kind} {key[0]!r}@{key[1]!r} "
>                 "with materially different content. Bump its version or set "
>                 "overwrite=True explicitly."
>             )
> 
>         store[key] = value
>         latest[key[0]] = key[1]
> 
>     @staticmethod
>     def _get(
>         store: Mapping[tuple[str, str], Any],
>         latest: Mapping[str, str],
>         identifier: str,
>         version: str | None,
>         kind: str,
>     ) -> Any:
>         resolved_version = version or latest.get(identifier)
>         if resolved_version is None:
>             raise KeyError(f"Unknown {kind}: {identifier!r}")
> 
>         try:
>             return store[(identifier, resolved_version)]
>         except KeyError as exc:
>             raise KeyError(
>                 f"Unknown {kind} version: {identifier!r}@{resolved_version!r}"
>             ) from exc
> 
>     @staticmethod
>     def _frozen_mapping(value: Mapping[str, Any] | None) -> Mapping[str, Any]:
>         return MappingProxyType(dict(value or {}))
> 
>     @staticmethod
>     def _require_identifier(value: str, name: str) -> None:
>         if not isinstance(value, str) or not value.strip():
>             raise ValueError(f"{name} must be a non-empty string.")
> 
>     @staticmethod
>     def _validate_prior(value: float | None, name: str) -> None:
>         if value is not None and not 0.0 <= value <= 1.0:
>             raise ValueError(f"{name} must lie in [0, 1].")
> 
>     @staticmethod
>     def _validate_nonnegative(value: float | None, name: str) -> None:
>         if value is not None and value < 0:
>             raise ValueError(f"{name} must be non-negative.")
> 
