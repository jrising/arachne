> def plan_text_graph(
>     plan: PlanSpec,
>     record: ResponseRecord | None = None,
> ) -> str:
>     lines = [
>         f"Plan: {plan.plan_id}@{plan.version}",
>         f"├─ template: {plan.template_id}",
>         f"├─ model: {plan.model_id or '(none)'}",
>     ]
> 
>     if plan.tool_bindings:
>         lines.append("├─ tools")
>         for i, binding in enumerate(plan.tool_bindings):
>             branch = "└─" if i == len(plan.tool_bindings) - 1 else "├─"
>             config = f" {dict(binding.config)!r}" if binding.config else ""
>             lines.append(
>                 f"│  {branch} {binding.tool_name}@{binding.tool_version}{config}"
>             )
>     else:
>         lines.append("├─ tools: none")
> 
>     if plan.risk_policy:
>         lines.append(f"├─ risk policy: {plan.risk_policy!r}")
> 
>     if record:
>         lines.extend([
>             f"└─ execution: {record.status}",
>             f"   ├─ response: {record.response_id}",
>             f"   ├─ latency: {record.metrics.latency_s!r}s",
>             f"   └─ estimated cost: ${record.metrics.estimated_cost_usd!r}",
>         ])
>     else:
>         lines.append("└─ execution: not yet started")
> 
>     return "\n".join(lines)
