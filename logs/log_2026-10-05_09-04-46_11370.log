> def extract_plan(text: str) -> tuple[str, JavaScriptPlan | None]:
>     matches = list(_PLAN.finditer(text))
>     if len(matches) > 1:
>         raise ValueError("Response contains multiple plan blocks.")
>     if not matches:
>         return text, None
> 
>     match = matches[0]
>     if text[match.end():].strip():
>         raise ValueError("Plan block must be a terminal footer.")
> 
>     source = match.group(1).strip()
>     validate(source)
>     return text[:match.start()].rstrip(), JavaScriptPlan(source=source)
