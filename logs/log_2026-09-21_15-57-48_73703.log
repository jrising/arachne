**assistant**:
> Using the NetCDF C API, a strict 2-D loader (expecting the variable dimensions to be ordered `[latitude, longitude]`) could be:
> 
> ```cpp
> #include <netcdf.h>
> #include <vector>
> #include <stdexcept>
> 
> static GeographicMap<T>* loadNetCDF(
>     DividedRange latitudes, DividedRange longitudes,
>     string filepath, string variableName) {
> 
>   int ncid, varid;
>   int status = nc_open(filepath.c_str(), NC_NOWRITE, &ncid);
>   if (status != NC_NOERR)
>     throw runtime_error("Could not open NetCDF file: " + filepath +
>                         ": " + nc_strerror(status));
> 
>   status = nc_inq_varid(ncid, variableName.c_str(), &varid);
>   if (status != NC_NOERR) {
>     nc_close(ncid);
>     throw runtime_error("Could not find NetCDF variable '" + variableName +
>                         "': " + nc_strerror(status));
>   }
> 
>   nc_type type;
>   int ndims, dimids[NC_MAX_VAR_DIMS], natts;
>   status = nc_inq_var(ncid, varid, NULL, &type, &ndims, dimids, &natts);
>   if (status != NC_NOERR || ndims != 2) {
>     nc_close(ncid);
>     throw runtime_error("NetCDF variable must have exactly two dimensions.");
>   }
> 
>   size_t rows, cols;
>   nc_inq_dimlen(ncid, dimids[0], &rows);
>   nc_inq_dimlen(ncid, dimids[1], &cols);
> 
>   if (rows != latitudes.count() || cols != longitudes.count()) {
>     nc_close(ncid);
>     throw runtime_error(
>       "NetCDF size mismatch: " + ToString::base10(rows) + " x " +
>       ToString::base10(cols) + " vs. " +
>       ToString::base10(latitudes.count()) + " x " +
>       ToString::base10(longitudes.count()));
>   }
> 
>   std::vector<double> buffer(rows * cols);
>   size_t start[] = { 0, 0 };
>   size_t count[] = { rows, cols };
> 
>   status = nc_get_vara_double(ncid, varid, start, count, buffer.data());
>   nc_close(ncid);
> 
>   if (status != NC_NOERR)
>     throw runtime_error("Could not read NetCDF variable: " +
>                         string(nc_strerror(status)));
> 
>   MatrixGeographicMap<T>* result =
>       new MatrixGeographicMap<T>(latitudes, longitudes);
> 
>   for (unsigned rr = 0; rr < rows; ++rr)
>     for (unsigned cc = 0; cc < cols; ++cc)
>       result->getValues().get(rr, cc) =
>           static_cast<T>(buffer[rr * cols + cc]);
> 
>   return result;
> }
> ```
> 
> Compile/link with NetCDF, e.g.:
> 
> ```bash
> g++ ... -lnetcdf
> ```
> 
> This deliberately uses `nc_get_vara_double`, so NetCDF converts numeric storage types uniformly. It does not automatically apply CF metadata such as `scale_factor`, `add_offset`, `_FillValue`, or reverse latitude order; those should be handled explicitly if your files use them.
> 
> Unrelated: your TIFF loop likely needs `+ row * width`, not `+ width`:
> 
> ```cpp
> TIFFReadScanline(tiff, result->values.getValues() + row * width, row)
> ```
