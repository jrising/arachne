> 
> ## System builders
> 
> ### In-memory system with simple retrieval
> 
> This is likely your default test stack.
> 
> ```python
> def build_inmemory_test_system() -> TestMemorySystem:
>     store = InMemoryStore()
>     model = MockMemoryModel()
>     index = SimpleTextMemoryIndex(store)
>     ltm = LongTermMemory(store=store, model=model, index=index)
>     return TestMemorySystem(
>         long_term_memory=ltm,
>         store=store,
>         model=model,
>         index=index,
>     )
> ```
> 
> ### In-memory without retrieval
> 
> Useful for fallback tests.
> 
> ```python
> def build_inmemory_null_index_system() -> TestMemorySystem:
>     store = InMemoryStore()
>     model = MockMemoryModel()
>     index = NullMemoryIndex()
>     ltm = LongTermMemory(store=store, model=model, index=index)
>     return TestMemorySystem(
>         long_term_memory=ltm,
>         store=store,
>         model=model,
>         index=index,
>     )
> ```
> 
> ### Temporary SQLite system
> 
> This is nice for testing the SQLAlchemy store.
> 
> ```python
> def build_sqlite_test_system(sqlite_url: str = "sqlite+pysqlite:///:memory:") -> TestMemorySystem:
>     engine = create_engine(sqlite_url, future=True)
>     Base.metadata.create_all(engine)
>     session_factory = sessionmaker(bind=engine, future=True, expire_on_commit=False, class_=Session)
> 
>     store = SQLAlchemyMemoryStore(session_factory=session_factory)
>     model = MockMemoryModel()
>     index = NullMemoryIndex()
>     ltm = LongTermMemory(store=store, model=model, index=index)
> 
>     return TestMemorySystem(
>         long_term_memory=ltm,
>         store=store,
>         model=model,
>         index=index,
>     )
> ```
