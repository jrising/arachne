>     ) -> None:
>         pass
> ```
> 
> ## Optional lightweight keyword test index
> 
> This is useful for integration tests without Whoosh.
> 
> ```python
> class SimpleTextMemoryIndex:
>     def __init__(self, store: MemoryStore) -> None:
>         self.store = store
> 
>     def index_memory(self, memory: MemoryRecord) -> None:
>         pass  # no-op; store is source of truth
> 
>     def remove_memory(self, memory_id: str) -> None:
>         pass
> 
>     def search(
>         self,
>         user_id: str,
>         query: str,
>         *,
>         kinds: Optional[Sequence[MemoryKind]] = None,
>         limit: int = 10,
>     ) -> list[str]:
>         query_terms = {term.lower() for term in query.split() if term.strip()}
>         candidates = self.store.list_memories(user_id, kind=None, active_only=True, limit=1000)
> 
>         if kinds is not None:
>             kindset = set(kinds)
>             candidates = [c for c in candidates if c.kind in kindset]
> 
>         scored: list[tuple[int, str]] = []
>         for memory in candidates:
>             haystack = " ".join(filter(None, [memory.content, memory.summary or "", " ".join(memory.tags)])).lower()
>             score = sum(1 for term in query_terms if term in haystack)
>             if score > 0:
>                 scored.append((score, memory.memory_id))
> 
>         scored.sort(reverse=True)
>         return [memory_id for _, memory_id in scored[:limit]]
> 
>     def index_conversation_summary(
>         self,
>         user_id: str,
>         conversation_id: str,
>         summary: str,
>         metadata: Optional[dict[str, Any]] = None,
>     ) -> None:
>         pass
> ```
