>         chunks = self.selector.stream_response(messages, max_tokens=max_tokens)
> 
>         response_id = str(uuid.uuid4())
>         responder = self.selector.last_responder
>         self.response_responders[response_id] = responder
> 
>         return StreamResponse(
>             id=response_id,
>             chunks=chunks,
>             model=str(responder),
>         )
> 
>     def vote_up(self, response_id):
>         responder = self.response_responders.get(response_id)
>         if responder is not None:
>             self.selector.successes[responder] += 1
> 
>     def vote_down(self, response_id):
>         responder = self.response_responders.get(response_id)
>         if responder is not None:
>             self.selector.failures[responder] += 1
> 
>     # Forward-compatible async API: no background tasks in v1.
>     def poll(self):
>         return []
> 
>     def ongoing(self):
>         return []
> 
>     def async_status(self):
>         return {
>             "count": 0,
>             "operations": [],
>         }
> ```
> 
> Usage:
> 
> ```python
> planner = Planner(conversation_id, selector)
> 
> stream = planner.stream_response(messages)
> for chunk in stream:
>     send_chunk_to_browser(chunk)
> 
> planner.vote_up(stream.id)
> ```
> 
> Later, `ongoing()` can return lightweight records such as `{id, description, started_at, status}`, and `poll()` can return completed background responses—without changing the chat-facing API.
