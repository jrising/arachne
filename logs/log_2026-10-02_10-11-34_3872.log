> =====
> planner/workflow/delivery.py
> """
> Async result delivery policy and user-visible update creation.
> 
> Every completed operation may update durable state. Only explicitly eligible
> results may create visible assistant messages. Do not generate noisy progress
> messages or silently revise earlier answers.
> 
> Public API:
> 
> class DeliveryService:
>     def consider_delivery(
>         self,
>         workflow: Workflow,
>         artifacts: Sequence[Artifact],
>         *,
>         original_response_id: str | None,
>     ) -> AsyncUpdate | None:
>         '''
>         Apply DeliveryPolicy: never, on_material_result, on_completion,
>         on_user_request, or digest. Enforce opt-in, quiet hours, materiality,
>         and max-update limits.
>         '''
>         ...
> 
>     def deliver(self, update: AsyncUpdate) -> None: ...
> 
> Visible updates must:
> - be ordinary new assistant messages;
> - identify their relation to the originating turn/response;
> - identify correction or supersession where applicable;
> - preserve links to operations and artifacts;
> - explain why delivery occurred.
> 
> Caller:
> - workers/scheduler call `consider_delivery` after results are persisted.
> - async_api.py exposes delivered-but-unread updates through `poll()`.
> """
> 
> =====
> planner/workflow/models.py
> """
> Workflow-DAG domain types.
> 
> A Plan is intended policy. An Operation is an executable unit. An Artifact is
> durable output. Dependencies define readiness. Continuations run after needed
> artifacts resolve. Subscriptions/watch rules react to future events.
> 
> Expected types:
> 
> @dataclass
> class Operation:
>     id: str
>     workflow_id: str
>     kind: str                 # model_call, tool_call, evaluator, job
>     status: Literal["pending", "ready", "running", "completed", "failed", "cancelled"]
>     plan_id: str | None
>     input: Mapping[str, Any]
>     dependency_ids: list[str]
>     artifact_ids: list[str]
>     created_at: float
>     started_at: float | None = None
>     completed_at: float | None = None
>     error: str | None = None
>     retry_count: int = 0
> 
> @dataclass
> class Artifact:
>     id: str
>     conversation_id: str
>     operation_id: str
>     kind: str                 # source_bundle, retrieval, draft, code_result, image, ...
>     content: Any
>     provenance: Provenance
>     created_at: float
>     expires_at: float | None = None
>     durable: bool = True
> 
> @dataclass
> class SourceExcerpt:
>     id: str
>     artifact_id: str
>     text: str
>     source_locator: str | None
>     relevance_score: float | None
>     provenance: Provenance
> 
> @dataclass
> class Workflow:
>     id: str
>     conversation_id: str
>     originating_turn_id: str | None
>     plan: PlanSpec
>     operations: dict[str, Operation]
>     delivery_policy: DeliveryPolicy
> 
> @dataclass
> class StatePatch:
>     scope: Literal["turn", "conversation", "project", "user_memory"]
>     target_id: str
>     patch: list[JsonPatchOp]
>     provenance: Provenance
>     confidence: float
>     write_policy: Literal["append", "replace", "propose_for_review"]
> 
> @dataclass
> class DeliveryPolicy:
>     mode: Literal["never", "on_material_result", "on_completion",
>                   "on_user_request", "digest"]
>     materiality_threshold: float = 0.0
>     quiet_hours: Any | None = None
>     require_user_opt_in: bool = False
>     max_updates_per_conversation: int = 1
> 
> Caller:
> - plans.py or responders.py creates a Workflow from a selected PlanSpec.
> - scheduler.py identifies runnable operations.
> - workers.py executes operations and emits artifacts/events.
> - reducer.py applies state patches.
> - delivery.py turns eligible artifacts into user-visible updates.
> """
> 
> =====
> planner/workflow/events.py
> """
> Append-only workflow event definitions and event-log interface.
> 
> Events are the audit trail for planning, execution, retries, artifacts, state
> updates, delivery decisions, and learning. State is derived from events rather
> than silently mutated wherever practical.
> 
> Expected event kinds:
> - workflow.created
> - operation.ready / started / completed / failed / cancelled
> - artifact.created
> - state.patch.proposed / applied / rejected
> - continuation.scheduled
> - async.update.delivered
> - feedback.recorded
> - evaluation.completed
> 
> Public API:
> 
> @dataclass(frozen=True)
> class Event:
>     id: str
>     kind: str
>     timestamp: float
>     conversation_id: str
>     workflow_id: str | None
>     operation_id: str | None
>     payload: Mapping[str, Any]
>     provenance: Provenance | None = None
> 
> class EventLog(Protocol):
>     def append(self, event: Event) -> None: ...
>     def read(self, conversation_id: str, after: str | None = None) -> list[Event]: ...
> 
> Caller:
> - planner.py emits workflow/response lifecycle events.
> - workers.py emits execution and artifact events.
> - reducer.py and scheduler.py consume events.
> - persistence.py implements EventLog or delegates it to infrastructure.
> """
> 
> =====
> planner/workflow/reducer.py
> """
> Event-to-state reducer.
> 
> The reducer creates durable, versioned conversation/project/user state from
> append-only events and approved StatePatches. It never rewrites canonical
> chat history.
> 
> Public API:
> 
> class StateReducer:
>     def reduce(self, event: Event) -> None: ...
>     def apply_patch(self, patch: StatePatch) -> None: ...
>     def state_for(self, scope: str, target_id: str) -> Mapping[str, Any]: ...
> 
> Required safeguards:
> - enforce patch scope and write policy;
> - retain provenance/confidence;
> - detect conflicting replacement patches;
> - use review/proposal state for sensitive user-memory writes;
> - make artifacts available to context.py only when eligible.
> 
> Caller:
> - event consumers call `reduce(event)` after event-log persistence.
> - context.py reads reduced state and ready artifacts.
> """
> 
> =====
> planner/workflow/scheduler.py
> """
> Workflow DAG readiness and continuation scheduling.
> 
> The scheduler determines which operations can begin based on completed
> dependencies. Independent operations should run concurrently where supported;
> it must not impose a serial model-tool loop when the selected plan already
> knows necessary work.
> 
> Public API:
> 
> class WorkflowScheduler:
>     def create_workflow(
>         self,
>         plan: PlanSpec,
>         context: PlannerContext,
>         strategy: Literal["wait", "provisional", "deferred"],
>     ) -> Workflow: ...
> 
>     def runnable_operations(self, workflow: Workflow) -> list[Operation]:
>         '''
>         Return pending operations whose required artifact/operation
>         dependencies are completed successfully.
>         '''
>         ...
> 
>     def mark_completed(
>         self,
>         workflow_id: str,
>         operation_id: str,
>         artifacts: Sequence[Artifact],
>         patches: Sequence[StatePatch],
>     ) -> list[Operation]: ...
> 
>     def schedule_continuations(self, event: Event) -> list[Operation]: ...
> 
> Caller:
> - responders.py uses it for synchronous execution of small workflows.
> - background workers use it for deferred/provisional workflows.
> - workers.py receives runnable operations from it.
> - it emits scheduling events through events.py.
> """
> 
> =====
> planner/workflow/workers.py
> """
> Operation execution workers.
> 
> Workers dispatch an Operation to a registered tool, model adapter, evaluator,
> or job handler. They produce typed artifacts and events. A worker must not
> choose plans or mutate transcript history.
> 
> Public API:
> 
> class OperationWorker(Protocol):
>     def execute(
>         self,
>         operation: Operation,
>         *,
>         context: PlannerContext,
>         registry: Registry,
>     ) -> ToolResult | Sequence[Artifact]: ...
> 
> class WorkerDispatcher:
>     def execute_ready_operations(
>         self,
>         workflow: Workflow,
>         operations: Sequence[Operation],
>     ) -> list[Event]: ...
> 
> Caller:
> - scheduler.py identifies readiness.
> - synchronous responders may invoke workers inline.
> - a future queue/worker service invokes the same API asynchronously.
> 
> Failures should be recorded structurally, with retry policy and output
> visibility governed by plan/workflow policy.
> """
> 
> =====
> planner/plans.py
> """
> Plan specification, templating, and instantiation.
> 
> This module defines the structure of a Plan, how PlanSpecs are templated from
> registered models and tools, and how they are instantiated into concrete
> candidate plans ready for selection and execution.
> 
> Important design rules:
> - Plans are immutable after instantiation.
> - Plan identity incorporates model/tool versions, prompts/instructions,
>   responder type, risk policy, and configuration variants that materially
>   affect behavior.
> - Tool configuration is a first-class decision variable.
> - Avoid arbitrary combinatorial model-tool generation. Start with a small,
>   explicit, bounded family of plans.
> - Examples: direct response; model + calculator; model + memory retrieval;
>   model + web/source grounding; draft + independent reviewer.
> 
> Expected helpers:
> 
> class PlanTemplate(Protocol):
>     def instantiate_plan(
>         self,
>         template_id: str,
>         model_specs: Mapping[str, ModelSpec],
>         tool_specs: Mapping[str, ToolSpec],
>         context: PlannerContext,
>         **template_args: Any,
>     ) -> PlanSpec: ...
> 
> def create_direct_plan_template(...) -> PlanTemplate: ...
> def create_tool_use_plan_template(...) -> PlanTemplate: ...
> def create_rag_plan_template(...) -> PlanTemplate: ...
> def create_reviewed_plan_template(...) -> PlanTemplate: ...
> 
> def generate_plans_from_templates(
>     templates: Sequence[PlanTemplate],
>     context: PlannerContext,
>     registry: Registry,
> ) -> list[PlanSpec]:
>     '''
>     Instantiate only plans feasible and eligible for this context. For example,
>     exclude plans whose required model/tool is unavailable, disallowed for the
>     risk category, or incompatible with available token budget.
>     '''
>     ...
> 
> Caller:
> - planner.py asks this module for current candidate plans.
> - registry.py stores explicitly registered plans.
> - selection.py receives concrete PlanSpecs, never templates.
> - responders.py interprets the selected plan's responder/template metadata.
> """
> 
> =====
> planner/async_api.py
> """
> Synchronous facade for internally asynchronous work.
> 
> Initial implementation is intentionally inert:
> 
>     poll() -> []
>     ongoing() -> []
>     async_status() -> {"count": 0, "operations": []}
> 
> Later it exposes durable workflow results without requiring application callers
> to become async.
> 
> Public API:
> 
> class AsyncWorkService:
>     def poll(self, conversation_id: str) -> list[AsyncUpdate]: ...
>     def ongoing(self, conversation_id: str) -> list[OperationSummary]: ...
>     def async_status(self, conversation_id: str) -> dict[str, Any]: ...
> 
> Caller:
> - planner.py delegates Planner.poll/ongoing/async_status here.
> - workflow/delivery.py writes eligible delivered updates.
> """
> 
> =====
> planner/selection.py
> """
> Pure plan-selection policy.
> 
> This module chooses a PlanSpec for a PlannerContext from eligible candidates.
> It applies learned evidence, quality priors, cost, latency, reliability risk,
> availability, and constrained exploration. It never executes plans or mutates
> durable state during selection.
> 
> Conceptual utility:
> 
>     U(p | x) =
>         w_s * predicted_satisfaction
>       + w_q * predicted_quality
>       - w_c * expected_cost
>       - w_l * expected_latency
>       - w_r * expected_risk
>       + w_e * exploration_value
> 
> Quality, reliability, user satisfaction, and cost/latency must remain separate
> evidence streams. Do not allow cheap fluent plans to dominate solely because
> they collect positive thumbs.
> """
> 
> from __future__ import annotations
> 
> import hashlib
> import json
> import math
> import random
> from typing import Any, Mapping, Sequence
> 
> from .types import PlanSpec, PlannerContext, ResponseRecord
> 
> 
> DEFAULT_WEIGHTS: Mapping[str, float] = {
>     "satisfaction": 1.0,
>     "quality_prior": 0.5,
>     "cost": 100.0,
>     "latency": 0.1,
>     "risk": 1.0,
>     "exploration": 0.05,
> }
> 
> DEFAULT_PROMPT_TOKENS = 100
> DEFAULT_COMPLETION_TOKENS = 200
> DEFAULT_LATENCY_S = 5.0
> 
> # Beta(1, 1): neutral, deliberately weak prior.
> ALPHA_PRIOR_SUCCESS = 1.0
> BETA_PRIOR_FAILURE = 1.0
> 
> DEFAULT_HIGH_STAKES_EXPLORATION_LIMIT = 2.0
> 
> 
> class PlanSelector:
>     """Pure, deterministic-given-seed plan-selection policy."""
> 
>     def __init__(
>         self,
>         weights: Mapping[str, float] | None = None,
>         *,
>         random_seed: int | None = None,
>         high_stakes_exploration_limit: float = (
>             DEFAULT_HIGH_STAKES_EXPLORATION_LIMIT
>         ),
>     ) -> None:
>         self.weights = {**DEFAULT_WEIGHTS, **(weights or {})}
>         self._random_seed = random_seed
>         self.high_stakes_exploration_limit = max(
>             1.0, high_stakes_exploration_limit
>         )
> 
>     def score_plan(
>         self,
>         plan: PlanSpec,
>         context: PlannerContext,
>         records: Sequence[ResponseRecord],
>     ) -> float:
>         """Return utility for one plan, retaining evidence streams separately."""
>         plan_records = [r for r in records if r.plan_id == plan.plan_id and r.plan_version == plan.version]
> 
>         # Satisfaction: only explicit votes are evidence. "neutral"/"skipped"
>         # responses must not silently become failures.
>         votes = [r.satisfaction_outcome for r in plan_records if r.satisfaction_outcome in ("up", "down")]
>         ups = sum(outcome == "up" for outcome in votes)
>         satisfaction = (
>             ALPHA_PRIOR_SUCCESS + ups
>         ) / (ALPHA_PRIOR_SUCCESS + BETA_PRIOR_FAILURE + len(votes))
> 
>         # Quality remains an independently registered/offline-evaluated prior.
>         quality = _bounded(getattr(plan, "quality_prior", 0.5), default=0.5)
> 
>         # Reliability is separate from satisfaction. A downvote can indicate
>         # poor usefulness, while a failed operation is a concrete reliability event.
>         attempts = [
>             r for r in plan_records
>             if getattr(r, "status", "unknown") != "in_progress"
>         ]
>         reliability_failures = sum(
>             getattr(r, "status", None) == "failure" for r in attempts
>         )
>         risk = (
>             BETA_PRIOR_FAILURE + reliability_failures
>         ) / (ALPHA_PRIOR_SUCCESS + BETA_PRIOR_FAILURE + len(attempts))
> 
>         observed_costs = [
>             cost for r in plan_records
>             if (cost := _record_cost(r)) is not None and cost >= 0
>         ]
>         cost = (
>             sum(observed_costs) / len(observed_costs)
>             if observed_costs
>             else _estimate_cost(plan, context)
>         )
> 
>         observed_latencies = [
>             latency for r in plan_records
>             if (latency := getattr(r, "latency_s", None)) is not None
>             and latency >= 0
>         ]
>         latency = (
>             sum(observed_latencies) / len(observed_latencies)
>             if observed_latencies
>             else max(0.0, getattr(plan, "estimated_latency_s", DEFAULT_LATENCY_S))
>         )
> 
>         # This is deliberately modest: uncertainty should permit exploration,
>         # not outweigh established quality or risk evidence.
>         exploration = 1.0 / math.sqrt(1.0 + len(plan_records))
> 
>         w = self.weights
>         return (
>             w["satisfaction"] * satisfaction
>             + w["quality_prior"] * quality
>             - w["cost"] * cost
>             - w["latency"] * latency
>             - w["risk"] * risk
>             + w["exploration"] * exploration
>         )
> 
>     def select_plan(
>         self,
>         context: PlannerContext,
>         candidate_plans: Sequence[PlanSpec],
>         past_response_records: Sequence[ResponseRecord] | None = None,
>     ) -> PlanSpec:
>         if not candidate_plans:
>             raise ValueError("No candidate plans provided.")
> 
>         records = past_response_records or ()
>         # Planner._plan_allowed has already applied dynamic availability,
>         # token-limit, and risk-policy checks.
>         eligible = list(candidate_plans)
> 
>         scores = [self.score_plan(plan, context, records) for plan in eligible]
> 
>         # Softmax preserves meaningful utility differences better than shifting
>         # scores into arbitrary positive roulette-wheel weights.
>         temperature = 1.0
>         if getattr(context, "is_high_stakes_task", False):
>             temperature /= self.high_stakes_exploration_limit
> 
>         probabilities = _softmax(scores, temperature=temperature)
> 
>         # A local RNG derived from stable inputs makes selection reproducible
>         # without mutable RNG state making identical requests vary unexpectedly.
>         rng = random.Random(
>             _selection_seed(
>                 self._random_seed,
>                 context,
>                 eligible,
>                 scores,
>                 records,
>             )
>         )
>         return rng.choices(eligible, weights=probabilities, k=1)[0]
> 
>     def update_weights(self, feedback: Any) -> None:
>         """Explicit hook for future externally-managed policy learning."""
>         # Weight learning belongs in evaluation/feedback infrastructure, not
>         # hidden selection-time mutation.
>         return None
> 
> 
> def _estimate_cost(plan: PlanSpec, context: PlannerContext) -> float:
>     return max(0.0, float(plan.metadata.get("estimated_cost_usd", 0.0)))
> 
> 
> def _record_cost(record: ResponseRecord) -> float | None:
>     """Accept the current and likely future ResponseRecord cost field names."""
>     for field in ("cost_usd", "cost", "actual_cost_usd"):
>         value = getattr(record, field, None)
>         if value is not None:
>             return float(value)
>     return None
> 
> 
> def _bounded(value: Any, *, default: float) -> float:
>     try:
>         return min(1.0, max(0.0, float(value)))
>     except (TypeError, ValueError):
>         return default
> 
> 
> def _softmax(scores: Sequence[float], *, temperature: float) -> list[float]:
>     scaled = [score / max(temperature, 1e-9) for score in scores]
>     maximum = max(scaled)
>     weights = [math.exp(min(700.0, value - maximum)) for value in scaled]
>     total = sum(weights)
>     return [weight / total for weight in weights]
> 
> 
> def _selection_seed(
>     configured_seed: int | None,
>     context: PlannerContext,
>     plans: Sequence[PlanSpec],
>     scores: Sequence[float],
>     records: Sequence[ResponseRecord],
> ) -> int:
>     payload = {
>         "configured_seed": configured_seed,
>         "conversation_id": getattr(context, "conversation_id", None),
>         "plans": [
>             (plan.plan_id, plan.version, round(score, 12))
>             for plan, score in zip(plans, scores)
>         ],
>         "records": [
>             (
