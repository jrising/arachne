> =====
> planner/feedback.py
> """
> Feedback event capture and response-to-plan attribution.
> 
> Feedback is always linked to immutable response records, not a mutable current
> responder. Thumbs are useful satisfaction signals, but they are not equivalent
> to truthfulness, source quality, or reliability.
> 
> Public API:
> 
> class FeedbackService:
>     def vote_up(self, response_id: str) -> FeedbackEvent: ...
>     def vote_down(self, response_id: str) -> FeedbackEvent: ...
> 
>     def feedback(
>         self,
>         response_id: str,
>         *,
>         kind: Literal["thumb_up", "thumb_down", "correction", "rating", "edit"],
>         value: Any = None,
>     ) -> FeedbackEvent: ...
> 
> Caller:
> - planner.py exposes `vote_up`, `vote_down`, and eventually `feedback`.
> - FeedbackService reads the ResponseRecord from persistence.py.
> - It writes durable feedback events and forwards attributable learning signals
>   to evaluation.py / selection.py.
> """
> 
> =====
> planner/evaluation.py
> """
> Quality, reliability, and offline evaluation.
> 
> This module prevents chat thumbs from becoming the sole optimization target.
> It maintains separate evidence for satisfaction, task quality, factuality,
> source grounding, calibration, policy compliance, tests, and failures.
> 
> Public API:
> 
> class Evaluator(Protocol):
>     def evaluate(
>         self,
>         record: ResponseRecord,
>         response: Response | None,
>         context: PlannerContext,
>     ) -> EvaluationResult: ...
> 
> class EvaluationService:
>     def record_feedback(self, feedback: FeedbackEvent) -> None: ...
>     def record_evaluation(self, result: EvaluationResult) -> None: ...
>     def update_plan_evidence(self, plan: PlanSpec) -> None: ...
>     def run_offline_suite(self, suite: EvaluationSuite) -> list[EvaluationResult]: ...
> 
> Evaluation suites should cover representative real work: research, coding,
> technical/numerical analysis, project continuity, planning, writing, and
> source-grounded factual tasks. Prefer objective tests when possible.
> 
> Caller:
> - feedback.py forwards user feedback.
> - workflow may schedule verification evaluators.
> - selection.py consumes summarized evidence, never raw evaluator internals.
> """
> 
> =====
> planner/tests/test_planner.py
> """
> Integration tests for the stable synchronous Planner API.
> 
> Test:
> - legacy tool registration works;
> - model registration and explicit plan generation work;
> - chat_response returns Response with ID/model;
> - stream_response is iterable and allocates ID before iteration;
> - response records persist selected plan attribution;
> - vote_up/down affect only the recorded response plan;
> - poll/ongoing/async_status preserve initial compatibility.
> """
> 
> =====
> planner/tests/test_streaming.py
> """
> Streaming lifecycle tests.
> 
> Test that:
> - response ID and record exist before first chunk;
> - completion latency is recorded after exhaustion;
> - pre-output failures may retry according to policy;
> - post-output failures do not silently change responder;
> - feedback can be applied to partial/failed streamed responses.
> """
> 
> =====
> planner/tests/test_selection.py
> """
> Selection-policy tests.
> 
> Test that:
> - unavailable models/plans are excluded;
> - priors influence cold-start choices;
> - positive and negative feedback affect attributed plans;
> - cost and latency are soft penalties;
> - bounded exploration occurs;
> - high-stakes context limits exploration and increases quality/risk weighting;
> - plan configuration variants remain distinct learning identities.
> """
> 
> =====
> planner/tests/test_workflow.py
> """
> Workflow DAG, event, reducer, and delivery tests.
> 
> Test that:
> - independent operations are runnable concurrently;
> - dependencies block downstream operations;
> - operation completion creates artifacts/events/state patches;
> - state patches do not alter transcript history;
> - delivery policy prevents unwanted visible updates;
> - material corrections create linked new AsyncUpdates;
> - event history supports complete audit reconstruction.
> """
> 
> =====
> planner/tests/test_context.py
> """
> Context assembly and provenance tests.
> 
> Test that:
> - canonical messages are unchanged;
> - selected plan determines injected instructions/artifacts;
> - irrelevant, stale, oversized, or disallowed artifacts are excluded;
> - retrieved text is labeled/protected as untrusted data;
> - token budgets are respected;
> - async operation status can be included without impersonating user messages.
> """
> 
> =====
> planner/__init__.py
> """
> Public Planner package API.
> 
> This module re-exports the stable application-facing interfaces:
> 
>     from .planner import Planner
>     from .types import (
>         PlannerContext, Response, StreamResponse, ToolConfig,
>         AsyncUpdate, ResponseRecord,
>     )
> 
> The ordinary application API is intentionally synchronous:
> 
>     planner = Planner(conversation_id="...")
>     response = planner.chat_response(messages)
>     stream = planner.stream_response(messages)
> 
>     planner.vote_up(response.id)
>     planner.vote_down(response.id)
> 
>     updates = planner.poll()
>     active = planner.ongoing()
>     status = planner.async_status()
> 
> Internally, plans may eventually execute asynchronous workflow DAGs, but
> callers must not need `await`, `async with`, or provider-specific APIs.
> """
> from .planner2 import Planner
> from .types import (
>     AsyncUpdate,
>     PlanSpec,
>     PlannerContext,
>     Response,
>     StreamResponse,
>     ToolBinding,
>     ToolConfig,
> )
> 
> __all__ = [
>     "AsyncUpdate",
>     "PlanSpec",
>     "Planner",
>     "PlannerContext",
>     "Response",
>     "StreamResponse",
>     "ToolBinding",
>     "ToolConfig",
> ]
> 
> =====
> planner/types.py
> """
> Shared immutable-ish domain types for planning, selection, execution,
> feedback, provenance, and durable state.
> 
> Important design rules:
> - A response is attributed to a concrete selected PlanSpec/version, never to
>   mutable state such as `selector.last_responder`.
> - Canonical user/assistant transcript messages are append-only and auditable.
> - Internal context, tool outputs, and async results belong in typed artifacts
>   and explicit state, not silently rewritten transcript text.
> - Tool configuration is part of plan identity and therefore learnable.
> - Full raw tool results may be retained temporarily; durable source material
>   should preserve exact excerpts actually relevant to a response.
> """
> 
> from __future__ import annotations
> 
> from dataclasses import dataclass, field
> from typing import (
>     Any,
>     Callable,
>     Iterator,
>     Literal,
>     Mapping,
>     Protocol,
>     Sequence,
>     TypeAlias,
> )
> 
> 
> JsonValue: TypeAlias = (
>     None | bool | int | float | str | list["JsonValue"] | dict[str, "JsonValue"]
> )
> JsonPatchOp: TypeAlias = Mapping[str, JsonValue]
> 
> ResponseStatus: TypeAlias = Literal["streaming", "completed", "failed", "cancelled"]
> TrustLevel: TypeAlias = Literal["untrusted", "external", "verified", "internal"]
> SourceKind: TypeAlias = Literal[
>     "tool", "model", "memory", "user", "system", "evaluator"
> ]
> StateScope: TypeAlias = Literal["turn", "conversation", "project", "user_memory"]
> WritePolicy: TypeAlias = Literal["append", "replace", "propose_for_review"]
> 
