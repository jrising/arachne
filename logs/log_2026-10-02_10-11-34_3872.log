> 
> def _find_by_type(value: Any, target_type: str) -> list[dict[str, Any]]:
>     """Find typed OpenAI response objects without trusting a fixed response shape."""
>     found: list[dict[str, Any]] = []
> 
>     if isinstance(value, Mapping):
>         if value.get("type") == target_type:
>             found.append(dict(value))
>         for child in value.values():
>             found.extend(_find_by_type(child, target_type))
>     elif isinstance(value, list):
>         for child in value:
>             found.extend(_find_by_type(child, target_type))
> 
>     return found
