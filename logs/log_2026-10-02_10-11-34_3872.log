> def _parse_container(config: Mapping[str, Any]) -> dict[str, Any] | str:
>     raw = config.get("container", {"type": "auto", "memory_limit": "1g"})
> 
>     if isinstance(raw, str):
>         if not _CONTAINER_ID_RE.fullmatch(raw):
>             raise ValueError("container string must be a container ID such as 'cntr_...'")
