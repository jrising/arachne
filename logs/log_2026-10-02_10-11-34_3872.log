> planner/tools/openai_image_generation.py
> """
> OpenAI Responses API image-generation tool.
> 
> This tool invokes OpenAI's `image_generation` Responses API tool and returns
> generated images as normalized Artifacts rather than display text.
> 
> Usage:
>     invocation = ToolInvocation(
>         operation_id="op_123",
>         conversation_id="conv_123",
>         arguments={
>             "prompt": "A clean schematic of a carbon-cycle box model",
>             "size": "1024x1536",
>             "quality": "high",
>             "output_format": "webp",
>         },
>         config={},
>         context=None,
>         provenance_requirements={},
>     )
>     result = openai_image_generation(invocation)
> 
> Arguments:
>     prompt: Required textual generation/edit instruction.
>     images: Optional list of image URLs or data URLs for edits.
>     previous_response_id: Optional prior Responses ID for multi-turn edits.
>     model, size, quality, output_format, output_compression, background,
>     action: Optional per-call overrides for configured defaults.
> 
> Configuration:
>     response_model: Mainline model which invokes image generation.
>     image_model: GPT Image model.
>     timeout_seconds: OpenAI client timeout.
>     allow_remote_image_urls: Whether HTTPS image URLs are permitted.
> 
> The image bytes are stored in Artifacts. Raw output intentionally excludes the
> base64 image payload, preventing oversized logs and accidental re-injection.
> """
> 
> from __future__ import annotations
> 
> import base64
> import os
> from collections.abc import Mapping
> from typing import Any
> 
> from openai import OpenAI
> 
> # Replace with the actual locations in your project.
> from ..contracts import Artifact, ToolInvocation, ToolResult
> 
> 
> _IMAGE_MODELS = {
>     "gpt-image-2.5-sunburst",
>     "gpt-image-2.5-flare",
>     "gpt-image-2",
>     "gpt-image-1.5",
>     "gpt-image-1",
>     "gpt-image-1-mini",
> }
> _QUALITIES = {"low", "medium", "high", "auto", "xhigh", "max"}
> _FORMATS = {"png", "jpeg", "webp"}
> _BACKGROUNDS = {"transparent", "opaque", "auto"}
> _ACTIONS = {"auto", "generate", "edit"}
> 
> 
