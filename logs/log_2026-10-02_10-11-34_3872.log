> """
> OpenAI Responses API Code Interpreter tool.
> 
> This tool asks an OpenAI model to use the `code_interpreter` capability: a
> sandboxed Python container that can analyse attached files and create outputs
> such as plots, CSVs, and notebooks.
> 
> Usage:
>     client = OpenAI()
>     tool = make_openai_code_interpreter_tool(client)
> 
>     result = tool.fn(ToolInvocation(
>         operation_id="op_123",
>         conversation_id="conv_123",
>         arguments={
>             "input": "Fit a log-linear trend to the attached CSV and save a plot."
>         },
>         config={
>             "container": {
>                 "type": "auto",
>                 "memory_limit": "4g",
>                 "file_ids": ["file-abc"],
>             }
>         },
>         context=None,
>         provenance_requirements={},
>     ))
> 
> Returned text, execution traces, and file citations are untrusted tool output.
> Generated files are represented as structured `container_file_citation`
> artifacts; download them promptly because containers expire after idle periods.
> """
> 
> from __future__ import annotations
> 
> from dataclasses import asdict, is_dataclass
> from datetime import datetime, timezone
> from typing import Any, Mapping, Sequence
> import re
> import time
> 
> from openai import OpenAI
> 
> # Replace with imports from your shared tool-contract module.
> from your_project.tools.contracts import Artifact, Tool, ToolInvocation, ToolResult
> 
> 
> _MEMORY_LIMITS = frozenset({"1g", "4g", "16g", "64g"})
> _CONTAINER_ID_RE = re.compile(r"^cntr_[A-Za-z0-9_-]+$")
> 
> 
> def _jsonable(value: Any) -> Any:
>     """Convert SDK/dataclass objects into persistable JSON-like values."""
>     if hasattr(value, "model_dump"):
>         return value.model_dump(mode="json")
>     if is_dataclass(value):
>         return asdict(value)
>     if isinstance(value, Mapping):
>         return {str(k): _jsonable(v) for k, v in value.items()}
>     if isinstance(value, (list, tuple)):
>         return [_jsonable(v) for v in value]
>     return value
