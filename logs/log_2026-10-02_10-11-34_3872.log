> """
> OpenAI Responses API shell tool adapter.
> 
> This tool asks an OpenAI model to perform a bounded shell-based task using the
> Responses API `shell` tool. Hosted shell environments execute commands inside an
> OpenAI-managed Debian container; returned shell output is preserved as untrusted
> Artifact data rather than injected into prompts or system instructions.
> 
> Usage:
> 
>     tool = make_openai_shell_tool(client, default_model="gpt-6-astra")
> 
>     result = tool.fn(ToolInvocation(
>         operation_id="op_123",
>         conversation_id="conv_123",
>         arguments={
>             "input": "Inspect /mnt/data/results.csv and report its columns.",
>             # Optional: "model": "gpt-6-astra",
>         },
>         config={
>             "environment": {
>                 "type": "container_auto",
>                 "network_policy": {
>                     "type": "allowlist",
>                     "allowed_domains": ["pypi.org"],
>                 },
>             },
>         },
>         context=None,
>         provenance_requirements={},
>     ))
> 
> `local` environments are intentionally unsupported by this adapter: safely
> running model-generated commands on the application host requires a dedicated,
> sandboxed local-shell executor and approval policy.
> """
> 
> from __future__ import annotations
> 
> import json
> from dataclasses import asdict, dataclass, field, is_dataclass
