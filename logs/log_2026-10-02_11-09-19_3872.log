> planner/responders.py
> """
> Execution of selected plans.
> 
> Responders take a selected PlanSpec and PlannerContext, construct effective
> messages, invoke registered model adapters and/or tools, and return a Response
> or StreamResponse plus a ResponseRecord.
> 
> Important design rules:
> - Responders execute; they do not choose plans or update durable learning.
> - Tool outputs require provenance/safety handling before model injection.
> - A responder must record model/tool failure, latency, tokens, and estimated
>   or observed cost.
> - For streaming, create the response record before yielding the first token.
> - Before visible output, a failed stream may be retried under planner policy.
>   After visible output, do not silently switch model or plan.
> """
> from __future__ import annotations
> 
> import json
> import time
> import uuid
> from dataclasses import dataclass
> from typing import Any, Callable, Iterator, Mapping, Sequence, TYPE_CHECKING
> 
> from .types import (
>     PlanSpec,
>     PlannerContext,
>     Response,
>     ResponseRecord,
>     StreamResponse,
>     ToolInvocation,
>     ToolResult,
> )
> 
> if TYPE_CHECKING:
>     from .registry import Registry
> 
> 
> Messages = Sequence[Mapping[str, Any]]
> MessageBuilder = Callable[[PlanSpec, PlannerContext], list[dict[str, Any]]]
> 
> 
> class ResponderExecutionError(RuntimeError):
>     """Execution failure retaining the record that must still be persisted."""
> 
>     def __init__(self, message: str, record: ResponseRecord) -> None:
>         super().__init__(message)
>         self.record = record
> 
> 
> class BaseResponder:
>     """Shared execution and measurement helpers."""
> 
>     def __init__(
>         self,
>         *,
>         message_builder: MessageBuilder | None = None,
>         completion_token_default: int = 512,
>     ) -> None:
>         self.message_builder = message_builder or self._default_messages
>         self.completion_token_default = completion_token_default
> 
>     def prepare(
>             self,
>             plan: PlanSpec,
>             context: PlannerContext,
>             max_tokens: int | None,
>     ) -> ResponseRecord:
>         return self._new_record(plan, context, max_tokens)
> 
> 
>     def _new_record(
>         self,
>         plan: PlanSpec,
>         context: PlannerContext,
>         max_tokens: int | None,
>     ) -> ResponseRecord:
>         messages = self.message_builder(plan, context)
>         prompt_tokens = self._estimate_tokens(messages)
>         completion_tokens = max_tokens or self.completion_token_default
> 
>         return ResponseRecord(
>             response_id=str(uuid.uuid4()),
>             conversation_id=str(context.metadata.get("conversation_id", "")),
>             turn_id=context.metadata.get("turn_id"),
>             plan_id=plan.plan_id,
>             plan_version=plan.version,
>             model_id=plan.model_id,
>             started_at=time.time(),
>             prompt_tokens=prompt_tokens,
>             estimated_cost_usd=None,
>         )
> 
>     @staticmethod
>     def _default_messages(
>         plan: PlanSpec,
>         context: PlannerContext,
>     ) -> list[dict[str, Any]]:
>         """
>         Transitional default until context.py owns effective-message assembly.
> 
>         New callers should place canonical messages in ``context.metadata`` as
>         ``messages``. `history_list_raw_data` is retained for compatibility.
>         """
>         supplied = context.metadata.get("messages")
>         if supplied is not None:
>             if not isinstance(supplied, Sequence):
>                 raise TypeError("context.metadata['messages'] must be a sequence.")
>             return [dict(message) for message in supplied]
> 
>         if context.history_list_raw_data:
>             return [{"role": "user", "content": context.history_list_raw_data}]
>         return []
> 
>     @staticmethod
>     def _estimate_tokens(value: Any) -> int:
>         """Deliberately rough fallback; replace with provider-aware accounting."""
>         return max(1, len(json.dumps(value, default=str)) // 4)
> 
>     @staticmethod
>     def _finish_record(
>         record: ResponseRecord,
>         *,
>         text: str | None = None,
>         error: Exception | None = None,
>     ) -> None:
>         record.completed_at = time.time()
>         record.latency_s = record.completed_at - record.started_at
> 
>         if error is not None:
>             record.status = "failed"
>             record.error = f"{type(error).__name__}: {error}"
>             return
> 
>         record.status = "completed"
>         record.completion_tokens = BaseResponder._estimate_tokens(text or "")
> 
>     @staticmethod
>     def _estimated_model_cost(
>         registry: "Registry",
>         plan: PlanSpec,
>         record: ResponseRecord,
>     ) -> float | None:
>         if plan.model_id is None:
>             return None
> 
>         model = registry.get_model_spec(plan.model_id)
>         if model.cost_per_million_tokens is None:
>             return None
> 
>         total = (record.prompt_tokens or 0) + (record.completion_tokens or 0)
>         return total * model.cost_per_million_tokens / 1_000_000
