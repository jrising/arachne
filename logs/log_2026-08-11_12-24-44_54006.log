> Below is a two-table version: **near term through 2050** and **long term in 2100**. It uses grouped headers to keep the warming comparison prominent, replaces `NA`s with em dashes, and lightly shades unavailable cells so readers do not confuse them with zeroes.
> 
> ```r
> library(dplyr)
> library(gt)
> ```
> 
> ## Format the two `gt` tables
> 
> ```r
> make_damage_table <- function(data, title, subtitle = NULL) {
> 
>   data %>%
>     gt(rowname_col = "Outcome") %>%
> 
>     tab_header(
>       title = title,
>       subtitle = subtitle
>     ) %>%
> 
>     # NA means unavailable, while a literal 0 remains 0
>     fmt_missing(
>       columns = -Outcome,
>       missing_text = "—"
>     ) %>%
> 
>     # Make unavailable estimates visually distinct, but unobtrusive
>     tab_style(
>       style = list(
>         cell_fill(color = "#F2F2F2"),
>         cell_text(color = "#777777")
>       ),
>       locations = cells_body(
>         columns = -Outcome,
>         rows = is.na
>       )
>     ) %>%
> 
>     # Center numeric/scenario cells; retain left-aligned outcome names
>     cols_align(
>       align = "center",
>       columns = -Outcome
>     ) %>%
> 
>     cols_width(
>       Outcome ~ px(210),
>       everything() ~ px(125)
>     ) %>%
> 
>     tab_source_note(
>       source_note =
>         "Entries report the central estimate, with uncertainty intervals in brackets. " |
>         "An em dash (—) indicates that an estimate is not currently available, not zero damages."
>     ) %>%
> 
>     tab_options(
>       table.font.size = px(10),
>       heading.title.font.size = px(14),
>       heading.subtitle.font.size = px(11),
>       column_labels.font.weight = "bold",
>       column_labels.background.color = "#E8F1F5",
>       stub.font.weight = "bold",
>       data_row.padding = px(4),
>       table.border.top.style = "solid",
>       table.border.top.width = px(1),
>       table.border.bottom.style = "solid",
>       table.border.bottom.width = px(1)
>     )
