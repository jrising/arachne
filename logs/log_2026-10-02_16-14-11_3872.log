> planner/decision.py
> from __future__ import annotations
> 
> import math, re
> from collections import defaultdict
> from typing import Mapping, Sequence
> 
> from .selection import PlanSelector
> from .types import PlanSpec, PlannerContext, ResponseRecord
> 
> _WORDS = {
>     "latest", "current", "today", "news", "recent", "update", "price",
>     "law", "policy", "guidance", "citation", "cite", "source", "sources",
>     "evidence", "research", "study", "studies", "who", "cdc",
> }
> _YEAR = re.compile(r"\b20\d{2}\b")
> 
> def query_features(messages: Sequence[Mapping]) -> tuple[str, ...]:
>     user_text = " ".join(
>         str(m.get("content", "")).lower()
>         for m in messages if m.get("role") == "user"
>     )
>     words = set(re.findall(r"[a-z]{3,}", user_text))
>     features = {f"word:{w}" for w in words & _WORDS}
> 
>     if _YEAR.search(user_text):
>         features.add("has_year")
>     if any(x in user_text for x in ("latest", "current", "today", "recent")):
>         features.add("freshness")
>     if any(x in user_text for x in ("cite", "source", "evidence", "research")):
>         features.add("grounding_requested")
>     if "?" in user_text:
>         features.add("question")
>     if len(user_text) > 500:
>         features.add("long_query")
> 
>     return tuple(sorted(features))
> 
> def _cue_bonus(plan: PlanSpec, features: set[str]) -> float:
>     mode = plan.metadata.get("execution_mode")
> 
>     if mode == "direct":
>         bonus = 0.15
>         if {"freshness", "grounding_requested"} & features:
>             bonus -= 0.35
>         return bonus
> 
>     if mode == "rag":
>         bonus = 0.0
>         if "grounding_requested" in features:
>             bonus += 0.45
>         if "freshness" in features:
>             bonus += 0.35
>         if "has_year" in features:
>             bonus += 0.10
>         return bonus
> 
>     if mode == "parallel":
>         # Best where research seems likely but not certain.
>         return 0.20 if (
>             "freshness" in features or "grounding_requested" in features
>         ) else -0.15
> 
>     return 0.0
> 
> class ThreeWaySelector(PlanSelector):
>     """
>     In-memory Beta-Bernoulli evidence. Persist these counts in evaluation/
>     persistence when moving beyond v1.
>     """
> 
>     def __init__(self, *args, learned_weight: float = 1.0, **kwargs):
>         super().__init__(*args, **kwargs)
>         self.learned_weight = learned_weight
>         self._evidence = defaultdict(lambda: [1.0, 1.0])  # (plan, feature) -> α, β
> 
>     def score_plan(self, plan, context, records):
>         score = super().score_plan(plan, context, records)
>         features = set(context.metadata.get("decision_features", ()))
>         score += _cue_bonus(plan, features)
>         
>         if not features:
>             return score
> 
>         # Mean posterior probability that this plan receives positive feedback
>         # for the active local cues; weak priors shrink sparse evidence to 0.5.
>         probabilities = []
>         for feature in features:
>             alpha, beta = self._evidence[(plan.plan_id, feature)]
>             probabilities.append(alpha / (alpha + beta))
> 
>         expected_success = sum(probabilities) / len(probabilities)
>         return score + self.learned_weight * (expected_success - 0.5)
> 
>     def observe(self, record: ResponseRecord, positive: bool) -> None:
>         for feature in record.decision_features:
>             alpha_beta = self._evidence[(record.plan_id, feature)]
>             alpha_beta[0 if positive else 1] += 1.0
