**user**:
> We have made an initial implementation of a new "planning" logic for responding to queries. Here is the current code, which includes many classes that will be implemented in a future version:
> 
> ===
> planner/metrics.py
> """
> Token, cost, latency, availability, and failure measurement.
> 
> All estimates are explicit and revisable. Observed provider usage should
> eventually supersede static provider price estimates.
> 
> Public helpers:
> 
> def estimate_prompt_tokens(messages: Sequence[Mapping[str, Any]]) -> int: ...
> def estimate_completion_tokens(max_tokens: int | None, plan: PlanSpec) -> int: ...
> def estimate_plan_cost(plan: PlanSpec, prompt_tokens: int, completion_tokens: int) -> float | None: ...
> def measure_latency() -> ContextManager[Callable[[], float]]: ...
> def record_execution_metrics(record: ResponseRecord, ...) -> ResponseRecord: ...
> 
> Caller:
> - selection.py uses estimates as soft cost/latency penalties.
> - responders.py measures observed execution metrics.
> - persistence.py stores metrics.
> - evaluation.py uses failures/reliability statistics.
> """
> 
> =====
> planner/Planner.py
> """
> Primary synchronous Planner facade and drop-in replacement for the existing API.
> 
> Planner coordinates registration, context assembly, candidate plan generation,
> selection, response execution, response attribution, feedback, and the
> forward-compatible async polling API.
> 
> The public application interface remains synchronous:
> 
> class Planner:
>     @classmethod
>     def register_model(
>         cls,
>         adapter: ModelAdapter,
>         *,
>         model_id: str,
>         cost_per_million_tokens: float | None = None,
>         quality_prior: float | None = None,
>         version: str = "1",
>     ) -> ModelSpec: ...
> 
>     @classmethod
>     def register_tool(
>         cls,
>         name: str,
>         description: str,
>         fn: Callable,
>         config: ToolConfig | Mapping[str, Any],
>         quality_prior: float | None = None,
>         cost_estimate: float | None = None,
>         version: str = "1",
>     ) -> ToolSpec: ...
> 
>     def __init__(
>         self,
>         conversation_id: str,
>         *,
>         repository: PlannerRepository | None = None,
>         registry: Registry | None = None,
>         selector: PlanSelector | None = None,
>     ): ...
> 
>     def chat_response(
>         self,
>         messages: Sequence[Mapping[str, Any]],
>         max_tokens: int | None = None,
>         context: PlannerContext | None = None,
>     ) -> Response: ...
> 
>     def stream_response(
>         self,
>         messages: Sequence[Mapping[str, Any]],
>         max_tokens: int | None = None,
>         context: PlannerContext | None = None,
>     ) -> StreamResponse: ...
> 
>     def vote_up(self, response_id: str) -> None: ...
>     def vote_down(self, response_id: str) -> None: ...
>     def feedback(self, response_id: str, *, kind: str, value: Any = None) -> None: ...
> 
>     def poll(self) -> list[AsyncUpdate]: ...
>     def ongoing(self) -> list[Any]: ...
>     def async_status(self) -> dict[str, Any]: ...
> 
>     def explain(self, response_id: str) -> Mapping[str, Any]: ...
> 
> Required synchronous request flow:
> 1. Validate/assemble PlannerContext.
> 2. Generate bounded eligible PlanSpecs from explicit templates.
> 3. Select a plan using PlanSelector.
> 4. Create and persist a ResponseRecord before execution/streaming.
> 5. Execute the relevant Responder.
> 6. Persist final metrics, artifacts, and failures.
> 7. Return Response or StreamResponse.
> 
> `stream_response` requirements:
> - allocate response ID before first yielded chunk;
> - set visible_output_started after first non-empty visible chunk;
> - record final metrics when exhausted or failed;
> - only retry before visible output, never silently after it.
> 
> Compatibility:
> - accepts the legacy `context` argument;
> - supports current `Planner.register_tool(**calculator_info)` usage;
> - initial async methods may return empty structures.
> """
> 
> import random, uuid
> from dataclasses import dataclass
> from typing import Any, Callable
> from .. import selector, openaigpt
> 
> @dataclass
> class PlannerContext:
>     user_id_for_memory: str
>     current_timestamp: float
>     history_list_raw_data: str = ""
> 
> @dataclass
> class Response:
>     id: str
>     text: str
>     model: str | None = None
> 
> @dataclass
> class StreamResponse:
>     id: str
>     chunks: object          # Iterator[str]
>     model: str | None = None
> 
>     def __iter__(self):
>         return iter(self.chunks)
> 
> @dataclass
> class Tool:
>     name: str
>     description: str
>     fn: Callable
>     config: dict[str, Any]
>     quality_prior: float | None = None
>     cost_estimate: float | None = None
>     
> class Planner:
>     tools: dict[str, Tool] = {}
> 
>     @classmethod
>     def register_tool(
>         cls,
>         name: str,
>         description: str,
>         fn: Callable,
>         config: dict[str, Any],
>         quality_prior: float | None = None,
>         cost_estimate: float | None = None,
>     ):
>         cls.tools[name] = Tool(
>             name=name,
>             description=description,
>             fn=fn,
>             config=config,
>             quality_prior=quality_prior,
>             cost_estimate=cost_estimate,
>         )
>     
>     def __init__(self, conversation_id):
>         self.conversation_id = conversation_id
>         self.selector = selector.BayesSelector([openaigpt])
>         self.response_responders = {}
> 
>     def stream_response(self, messages, max_tokens=None, context=None):
>         chunks = self.selector.stream_response(messages, max_tokens=max_tokens)
> 
>         response_id = str(uuid.uuid4())
>         responder = self.selector.last_responder
>         self.response_responders[response_id] = responder
> 
>         return StreamResponse(response_id, chunks, str(responder))
> 
>     def vote_up(self, response_id):
>         responder = self.response_responders.get(response_id)
>         if responder is not None:
>             self.selector.successes[responder] += 1
> 
>     def vote_down(self, response_id):
>         responder = self.response_responders.get(response_id)
>         if responder is not None:
>             self.selector.failures[responder] += 1
> 
>     # Forward-compatible async API: no background tasks in v1.
>     def poll(self):
>         return []
> 
>     def ongoing(self):
>         return []
> 
>     def async_status(self):
>         return {
>             "count": 0,
>             "operations": [],
>         }
> 
> =====
> planner/persistence.py
> """
> Durable storage interfaces and initial in-memory implementations.
> 
> Persistence is separated from planning so a local prototype can use in-memory
> stores while production uses SQLite, Postgres, Redis, object storage, queues,
> or event infrastructure.
> 
> Persist at minimum:
> - registered model/tool/plan versions;
> - response-to-plan attribution and feedback;
> - quality, reliability, failure, cost, token, and latency evidence;
> - artifacts, exact source excerpts, state patches, and async operations;
> - conversation state, events, evaluation outcomes, and delivery records.
> """
> 
> from __future__ import annotations
> 
> from collections import defaultdict
> from copy import deepcopy
> from threading import RLock
> from typing import Any, Mapping, Protocol, Sequence, runtime_checkable
> 
> from .types import FeedbackEvent, ResponseRecord
> from .types import Artifact, FeedbackEvent, ResponseRecord, StatePatch
> from typing import TYPE_CHECKING
> 
> if TYPE_CHECKING:
>     from .workflow.events import Event
>     from .workflow.models import Operation
> 
> 
> @runtime_checkable
> class PlannerRepository(Protocol):
>     """Persistence boundary for planner, workflow, context, and feedback code."""
> 
>     def save_response_record(self, record: ResponseRecord) -> None: ...
>     def get_response_record(self, response_id: str) -> ResponseRecord | None: ...
>     def append_feedback(self, event: FeedbackEvent) -> None: ...
> 
>     def response_records_for_plan(
>         self,
>         plan_id: str,
>         version: str,
>     ) -> list[ResponseRecord]: ...
> 
>     def append_event(self, event: Event) -> None: ...
>     def events_for_conversation(self, conversation_id: str) -> list[Event]: ...
> 
>     def get_state(self, scope: str, target_id: str) -> Mapping[str, Any]: ...
>     def apply_state_patch(self, patch: StatePatch) -> None: ...
> 
>     def save_artifact(self, artifact: Artifact) -> None: ...
>     def get_artifacts(
>         self,
>         conversation_id: str,
>         *,
>         artifact_ids: Sequence[str] | None = None,
>         kind: str | None = None,
>         status: str | None = "ready",
>     ) -> list[Artifact]: ...
> 
>     def save_operation(self, operation: Operation) -> None: ...
>     def get_operation(self, operation_id: str) -> Operation | None: ...
> 
> 
> class InMemoryRepository:
>     """
>     Thread-safe development implementation.
> 
>     Returned records and values are deep-copied so callers cannot mutate
>     repository state without an explicit repository write.
>     """
> 
>     def __init__(self) -> None:
>         self._lock = RLock()
> 
>         self._response_records: dict[str, ResponseRecord] = {}
>         self._feedback: list[FeedbackEvent] = []
> 
>         self._events_by_conversation: dict[str, list[Event]] = defaultdict(list)
>         self._state: dict[tuple[str, str], dict[str, Any]] = {}
> 
>         self._artifacts: dict[str, Artifact] = {}
>         self._artifact_ids_by_conversation: dict[str, list[str]] = defaultdict(list)
> 
>         self._operations: dict[str, Operation] = {}
> 
>     def save_response_record(self, record: ResponseRecord) -> None:
>         with self._lock:
>             self._response_records[record.response_id] = deepcopy(record)
> 
>     def get_response_record(self, response_id: str) -> ResponseRecord | None:
>         with self._lock:
>             record = self._response_records.get(response_id)
>             return deepcopy(record) if record is not None else None
> 
>     def append_feedback(self, event: FeedbackEvent) -> None:
>         with self._lock:
>             self._feedback.append(deepcopy(event))
> 
>     def response_records_for_plan(
>         self,
>         plan_id: str,
>         version: str,
>     ) -> list[ResponseRecord]:
>         with self._lock:
>             records = [
>                 record
>                 for record in self._response_records.values()
>                 if record.plan_id == plan_id
>                 and _record_plan_version(record) == version
>             ]
>             return deepcopy(records)
> 
>     def append_event(self, event: Any) -> None:
>         conversation_id = _conversation_id(event)
>         if not conversation_id:
>             raise ValueError("Events must include a conversation_id.")
> 
>         with self._lock:
>             self._events_by_conversation[conversation_id].append(deepcopy(event))
> 
>     def events_for_conversation(self, conversation_id: str) -> list[Event]:
>         with self._lock:
>             return deepcopy(self._events_by_conversation.get(conversation_id, []))
> 
>     def get_state(self, scope: str, target_id: str) -> Mapping[str, Any]:
>         with self._lock:
>             return deepcopy(self._state.get((scope, target_id), {}))
> 
>     def apply_state_patch(self, patch: StatePatch) -> None:
>         """
>         Apply a small RFC-6902-compatible subset: add, replace, remove.
> 
>         StatePatch provenance and write_policy are retained by the event layer;
>         this repository applies only the resulting state mutation.
>         """
>         key = (patch.scope, patch.target_id)
> 
>         with self._lock:
>             state = deepcopy(self._state.get(key, {}))
> 
>             for operation in patch.patch:
>                 op = _patch_field(operation, "op")
>                 path = _patch_field(operation, "path")
>                 value = _patch_field(operation, "value", missing=True)
> 
>                 if not isinstance(path, str) or not path.startswith("/"):
>                     raise ValueError(f"Invalid JSON-patch path: {path!r}")
> 
>                 _apply_json_patch_operation(state, op, path, value)
> 
>             self._state[key] = state
> 
>     def save_artifact(self, artifact: Artifact) -> None:
>         artifact_id = _object_id(artifact)
>         conversation_id = _conversation_id(artifact)
> 
>         if not artifact_id:
>             raise ValueError("Artifacts must include an id.")
>         if not conversation_id:
>             raise ValueError("Artifacts must include a conversation_id.")
> 
>         with self._lock:
>             is_new = artifact_id not in self._artifacts
>             self._artifacts[artifact_id] = deepcopy(artifact)
> 
>             if is_new:
>                 self._artifact_ids_by_conversation[conversation_id].append(artifact_id)
> 
>     def get_artifacts(
>         self,
>         conversation_id: str,
>         *,
>         artifact_ids: Sequence[str] | None = None,
>         kind: str | None = None,
>         status: str | None = "ready",
>     ) -> list[Artifact]:
>         allowed_ids = set(artifact_ids) if artifact_ids is not None else None
> 
>         with self._lock:
>             artifacts = []
>             for artifact_id in self._artifact_ids_by_conversation.get(
>                 conversation_id, []
>             ):
>                 artifact = self._artifacts[artifact_id]
> 
>                 if allowed_ids is not None and artifact_id not in allowed_ids:
>                     continue
>                 if kind is not None and getattr(artifact, "kind", None) != kind:
>                     continue
>                 if status is not None and getattr(artifact, "status", None) != status:
>                     continue
> 
>                 artifacts.append(deepcopy(artifact))
> 
>             return artifacts
> 
>     def save_operation(self, operation: Any) -> None:
>         operation_id = _object_id(operation)
>         if not operation_id:
>             raise ValueError("Operations must include an id.")
> 
>         with self._lock:
>             self._operations[operation_id] = deepcopy(operation)
> 
>     def get_operation(self, operation_id: str) -> Any | None:
>         with self._lock:
>             operation = self._operations.get(operation_id)
>             return deepcopy(operation) if operation is not None else None
> 
> 
> _MISSING = object()
> 
> 
> def _record_plan_version(record: ResponseRecord) -> str | None:
>     """Support the preferred plan_version field and early naming variants."""
>     return (
>         getattr(record, "plan_version", None)
>         or getattr(record, "plan_version_id", None)
>         or getattr(record, "version", None)
>     )
> 
> 
> def _object_id(value: Any) -> str | None:
>     return (
>         getattr(value, "id", None)
>         or getattr(value, "response_id", None)
>         or getattr(value, "artifact_id", None)
>         or getattr(value, "operation_id", None)
>     )
> 
> def _conversation_id(value: Any) -> str | None:
>     conversation_id = getattr(value, "conversation_id", None)
>     if conversation_id:
>         return conversation_id
>     metadata = getattr(value, "metadata", None)
>     if isinstance(metadata, Mapping):
>         candidate = metadata.get("conversation_id")
>         return candidate if isinstance(candidate, str) and candidate else None
>     return None
> 
> def _patch_field(operation: Any, field: str, *, missing: bool = False) -> Any:
>     if isinstance(operation, Mapping):
>         value = operation.get(field, _MISSING)
>     else:
>         value = getattr(operation, field, _MISSING)
> 
>     if value is _MISSING and not missing:
>         raise ValueError(f"State patch operation lacks {field!r}.")
>     return value
> 
> 
> def _apply_json_patch_operation(
>     document: dict[str, Any],
>     op: str,
>     path: str,
>     value: Any,
> ) -> None:
>     tokens = [
>         token.replace("~1", "/").replace("~0", "~")
>         for token in path.lstrip("/").split("/")
>     ]
> 
>     if not tokens or tokens == [""]:
>         raise ValueError("Patching the state document root is not supported.")
> 
>     parent: dict[str, Any] = document
>     for token in tokens[:-1]:
>         if token not in parent:
>             if op == "add":
>                 parent[token] = {}
>             else:
>                 raise KeyError(f"Patch path does not exist: {path!r}")
> 
>         if not isinstance(parent[token], dict):
>             raise ValueError(f"Patch path parent is not an object: {path!r}")
> 
>         parent = parent[token]
> 
>     key = tokens[-1]
> 
>     if op == "add":
>         parent[key] = deepcopy(value)
>     elif op == "replace":
>         if key not in parent:
>             raise KeyError(f"Cannot replace missing path: {path!r}")
>         parent[key] = deepcopy(value)
>     elif op == "remove":
>         if key not in parent:
>             raise KeyError(f"Cannot remove missing path: {path!r}")
>         del parent[key]
>     else:
>         raise ValueError(f"Unsupported state patch operation: {op!r}")
> 
> 
> =====
> planner/registry.py
> """
> Shared, version-aware registry for models, tools, plans, and plan templates.
> 
> Registry entries are registered once and then referenced by stable IDs and
> versions. The registry contains capability metadata; it does not execute
> providers and does not decide which plan to use.
> """
> 
> from __future__ import annotations
> 
> from dataclasses import dataclass
> from threading import RLock
> from types import MappingProxyType
> from typing import Any, Callable, Mapping, Protocol
> 
> from .types import ModelSpec, PlanSpec, PlannerContext, ToolConfig, ToolSpec
> 
> 
> class ModelAdapter(Protocol):
>     """Minimum model-adapter surface required by registered models."""
> 
>     def chat_response(
>         self,
>         messages: list[Mapping[str, Any]],
>         max_tokens: int | None = None,
>     ) -> str: ...
> 
>     def stream_response(
>         self,
>         messages: list[Mapping[str, Any]],
>         max_tokens: int | None = None,
>     ): ...
> 
>     def allowed(self, tokens: int) -> bool: ...
> 
> 
> @dataclass(frozen=True)
> class RegisteredModel:
>     """A versioned model specification plus its local provider adapter."""
> 
>     spec: ModelSpec
>     adapter: ModelAdapter
> 
> 
> @dataclass(frozen=True)
> class RegisteredTool:
>     """A versioned tool specification plus its executable callable."""
> 
>     spec: ToolSpec
>     fn: Callable[..., Any]
> 
> 
> class Registry:
>     """
>     Thread-safe in-process registry.
> 
>     Registration is idempotent for materially equivalent entries. Reusing an
>     existing ID/version with different capability metadata or executable
>     bindings raises ValueError unless `overwrite=True` is explicitly supplied.
>     """
> 
>     def __init__(self) -> None:
>         self._models: dict[tuple[str, str], RegisteredModel] = {}
>         self._tools: dict[tuple[str, str], RegisteredTool] = {}
>         self._plans: dict[tuple[str, str], PlanSpec] = {}
> 
>         # Explicit latest pointers avoid incorrect lexical version sorting.
>         self._latest_model_versions: dict[str, str] = {}
>         self._latest_tool_versions: dict[str, str] = {}
>         self._latest_plan_versions: dict[str, str] = {}
> 
>         self._lock = RLock()
> 
>     def register_model(
>         self,
>         adapter: ModelAdapter,
>         *,
>         model_id: str,
>         cost_per_million_tokens: float | None = None,
>         quality_prior: float | None = None,
>         version: str = "1",
>         metadata: Mapping[str, Any] | None = None,
>         overwrite: bool = False,
>     ) -> ModelSpec:
>         self._require_identifier(model_id, "model_id")
>         self._require_identifier(version, "version")
>         self._validate_prior(quality_prior, "quality_prior")
>         self._validate_nonnegative(cost_per_million_tokens, "cost_per_million_tokens")
> 
>         adapter_id = str(
>             getattr(adapter, "adapter_id", None)
>             or getattr(adapter, "id", None)
>             or adapter.__class__.__qualname__
>         )
>         spec = ModelSpec(
>             model_id=model_id,
>             adapter_id=adapter_id,
>             version=version,
>             cost_per_million_tokens=cost_per_million_tokens,
>             quality_prior=quality_prior,
>             metadata=self._frozen_mapping(metadata),
>         )
>         entry = RegisteredModel(spec=spec, adapter=adapter)
> 
>         with self._lock:
>             self._register_versioned(
>                 store=self._models,
>                 latest=self._latest_model_versions,
>                 key=(model_id, version),
>                 value=entry,
>                 equivalent=lambda old, new: (
>                     old.spec == new.spec and old.adapter is new.adapter
>                 ),
>                 overwrite=overwrite,
>                 kind="model",
>             )
>         return spec
> 
>     def register_tool(
>         self,
>         *,
>         name: str,
>         description: str,
>         fn: Callable[..., Any],
>         config: ToolConfig | Mapping[str, Any] | None = None,
>         quality_prior: float | None = None,
>         cost_estimate: float | None = None,
>         version: str = "1",
>         metadata: Mapping[str, Any] | None = None,
>         overwrite: bool = False,
>     ) -> ToolSpec:
>         self._require_identifier(name, "name")
>         self._require_identifier(version, "version")
>         if not description.strip():
>             raise ValueError("Tool description must not be empty.")
>         if not callable(fn):
>             raise TypeError("Tool fn must be callable.")
> 
>         self._validate_prior(quality_prior, "quality_prior")
>         self._validate_nonnegative(cost_estimate, "cost_estimate")
>         tool_config = self._coerce_tool_config(config)
> 
>         spec = ToolSpec(
>             name=name,
>             description=description,
>             version=version,
>             config=tool_config,
>             quality_prior=quality_prior,
>             cost_estimate=cost_estimate,
>             metadata=self._frozen_mapping(metadata),
>         )
>         entry = RegisteredTool(spec=spec, fn=fn)
> 
>         with self._lock:
>             self._register_versioned(
>                 store=self._tools,
>                 latest=self._latest_tool_versions,
>                 key=(name, version),
>                 value=entry,
>                 equivalent=lambda old, new: old.spec == new.spec and old.fn is new.fn,
>                 overwrite=overwrite,
>                 kind="tool",
>             )
>         return spec
> 
>     def register_plan(self, plan: PlanSpec, *, overwrite: bool = False) -> PlanSpec:
>         self._require_identifier(plan.plan_id, "plan_id")
>         self._require_identifier(plan.version, "version")
> 
>         with self._lock:
>             self._validate_plan_references(plan)
>             self._register_versioned(
>                 store=self._plans,
>                 latest=self._latest_plan_versions,
>                 key=(plan.plan_id, plan.version),
>                 value=plan,
>                 equivalent=lambda old, new: old == new,
>                 overwrite=overwrite,
>                 kind="plan",
>             )
>         return plan
> 
>     def get_model(
>         self, model_id: str, version: str | None = None
>     ) -> RegisteredModel:
>         return self._get(
>             self._models,
>             self._latest_model_versions,
>             model_id,
>             version,
>             "model",
>         )
> 
>     def get_model_spec(self, model_id: str, version: str | None = None) -> ModelSpec:
>         return self.get_model(model_id, version).spec
> 
>     def get_tool(self, name: str, version: str | None = None) -> RegisteredTool:
>         return self._get(
>             self._tools,
>             self._latest_tool_versions,
>             name,
>             version,
>             "tool",
>         )
> 
>     def get_tool_spec(self, name: str, version: str | None = None) -> ToolSpec:
>         return self.get_tool(name, version).spec
> 
>     def get_plan(self, plan_id: str, version: str | None = None) -> PlanSpec:
>         return self._get(
>             self._plans,
>             self._latest_plan_versions,
>             plan_id,
>             version,
>             "plan",
>         )
> 
>     def eligible_plans(
>         self,
>         context: PlannerContext | None = None,
>     ) -> list[PlanSpec]:
>         """
>         Return registered plans whose declared static constraints fit context.
> 
>         Supported optional plan metadata:
>         - ``enabled``: bool, default True
>         - ``task_classes``: sequence[str]
>         - ``risk_levels``: sequence[str]
> 
>         Dynamic provider availability remains the responder/selection layer's
>         responsibility because it can depend on token counts and live quotas.
>         """
