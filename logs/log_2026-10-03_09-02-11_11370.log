> 
>         try:
>             if not model.adapter.allowed(record.prompt_tokens or 0):
>                 raise RuntimeError(f"Model {plan.model_id!r} is currently unavailable.")
> 
>             text = model.adapter.chat_response(messages, max_tokens=max_tokens)
>             research_plan = None
