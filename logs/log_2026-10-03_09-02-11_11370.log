> planner/__init__.py
> """
> Public Planner package API.
> 
> This module re-exports the stable application-facing interfaces:
> 
>     from .planner import Planner
>     from .types import (
>         PlannerContext, Response, StreamResponse, ToolConfig,
>         AsyncUpdate, ResponseRecord,
>     )
> 
> The ordinary application API is intentionally synchronous:
> 
>     planner = Planner(conversation_id="...")
>     response = planner.chat_response(messages)
>     stream = planner.stream_response(messages)
> 
>     planner.vote_up(response.id)
>     planner.vote_down(response.id)
> 
>     updates = planner.poll()
>     active = planner.ongoing()
>     status = planner.async_status()
> 
> Internally, plans may eventually execute asynchronous workflow DAGs, but
> callers must not need `await`, `async with`, or provider-specific APIs.
> """
