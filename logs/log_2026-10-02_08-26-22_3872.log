> def retrieve_memory_context(invocation: ToolInvocation) -> ToolResult:
>     """Retrieve conversational memory as an explicitly untrusted artifact."""
>     if invocation.context is None:
>         raise ValueError("retrieve_memory_context requires PlannerContext.")
