> 
> 
> calculator_info = {
>     "name": "retrieve_memory_context",
>     "description": "Retrieve short- and long-term conversational memory.",
>     "fn": retrieve_memory_context_legacy,
>     "config": {
>         "defaults": {"strategy": "short_term_only"},
>         "options": {
>             "strategy": [
