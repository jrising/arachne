>                 or artifact.content.get("summary")
>                 or artifact.content.get("text")
>                 or artifact.content.get("answer")
>                 or artifact.content.get("answer_text")
>                 or ""
>             )
>     elif isinstance(artifact.content, str):
>         text = artifact.content
> 
>     parts = [
