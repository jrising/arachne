> class ParallelDirectWebJavaScriptResponder(WebRagJavaScriptResponder):
>     """
>     Start a private draft and retrieval concurrently.  The required phase-2
>     JS-planning request receives both, so retrieval is actually usable.
>     """
> 
>     def _phase_two_context(self, plan, context, registry, record, max_tokens):
>         model = registry.get_model(plan.model_id, plan.model_version)
>         direct_messages = self.message_builder(plan, context)
> 
>         with ThreadPoolExecutor(max_workers=2) as pool:
>             metrics = MetricsTracker(record)
>             metrics.add_model_call()
> 
>             draft_future = pool.submit(
>                 model.adapter.chat_response, direct_messages, max_tokens
>             )
>             search_future = pool.submit(
>                 self._context_with_search, plan, context, registry, record
>             )
> 
>             draft = draft_future.result()
>             searched_context = search_future.result()
> 
>         messages = list(searched_context.metadata["messages"])
>         messages.append({
>             "role": "system",
>             "content": (
>                 "A preliminary private draft follows. Revise it using the "
>                 "untrusted source evidence above. Do not repeat unsupported "
>                 "claims. If more research would materially improve coverage, "
>                 "append a terminal JavaScript plan.\n\n"
>                 f"PRELIMINARY DRAFT:\n{draft}"
>             ),
>         })
>         return replace(
>             searched_context,
>             metadata={**dict(searched_context.metadata), "messages": messages},
>         )
> 
>     def chat_response(self, plan, context, registry, *, record, max_tokens=None):
