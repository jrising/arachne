>   # path.rpart returns the sequence of rules to reach a node
>   left_path <- path.rpart(fit, nodes = left_node, print.it = FALSE)[[1]]
>   right_path <- path.rpart(fit, nodes = right_node, print.it = FALSE)[[1]]
>   
>   # Drop the "root" entry if present, then take the last rule
>   clean_last_rule <- function(path_vec) {
>     path_vec <- path_vec[path_vec != "root"]
>     if (length(path_vec) == 0) return(NA_character_)
>     tail(path_vec, 1)
>   }
>   
>   left_condition <- clean_last_rule(left_path)
>   right_condition <- clean_last_rule(right_path)
>   
>   # Optionally prettify spacing a little
>   if (pretty > 0) {
>     prettify <- function(s) {
>       s <- gsub("< ", "< ", s, fixed = TRUE)
>       s <- gsub(">=", ">= ", s, fixed = TRUE)
>       s <- gsub("=  ", "= ", s, fixed = TRUE)
>       s
>     }
>     left_condition <- prettify(left_condition)
>     right_condition <- prettify(right_condition)
>   }
>   
>   list(
>     variable = variable,
>     node = node,
>     left = list(
>       node = left_node,
>       condition = left_condition,
>       mean_y = left_mean_y
>     ),
>     right = list(
>       node = right_node,
>       condition = right_condition,
>       mean_y = right_mean_y
>     )
>   )
> }
> ```
> 
> ## Example
> 
> For your tree
> 
> ```r
> 1) root 55 0.2125885000 0.046794720  
>   2) persist>=0.18 47 0.0044686020 0.021448270  
>     4) persist>=0.69 11 0.0001680729 0.008942701 *
>     5) persist< 0.69 36 0.0020546050 0.025269420 *
>   3) persist< 0.18 8 0.0005307641 0.195705100 *
> ```
> 
> calling
> 
> ```r
> get_rpart_split(mod, 1)
> ```
> 
> should give something like
> 
> ```r
> $variable
> [1] "persist"
> 
> $left
> $left$node
> [1] 2
> 
> $left$condition
> [1] "persist>=0.18"
> 
> $left$mean_y
> [1] 0.02144827
> 
> $right
> $right$node
> [1] 3
> 
> $right$condition
> [1] "persist< 0.18"
> 
> $right$mean_y
> [1] 0.1957051
> ```
> 
> which matches the actual tree orientation.
> 
> ## Why this is the best approach here
> 
> Instead of reverse-engineering:
> 
> - `splits`
> - `csplit`
> - `where`
> - level order
> - left/right numeric orientation
> 
> we just ask `rpart` for the path text it already knows. That makes it:
> 
> - simpler
> - more robust
> - aligned with what gets printed
> 
> ## If you want parsed output
> If you'd like, I can also make a version that parses the returned condition into structured pieces, e.g.
> 
> ```r
> $left$operator
> $left$value
> $left$levels
> ```
> 
> so numeric and factor splits become machine-readable, not just strings.
