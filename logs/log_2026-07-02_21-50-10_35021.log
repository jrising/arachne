>   
>   out <- list(
>     variable = variable,
>     left = list(mean_y = left_mean_y),
>     right = list(mean_y = right_mean_y)
>   )
>   
>   if (ncat < 0) {
>     out$type <- "numeric"
>     out$split_point <- unname(index)
>     out$left$condition <- paste(variable, "<", format(index, digits = 12))
>     out$right$condition <- paste(variable, ">=", format(index, digits = 12))
>   } else {
>     levs <- fit$xlevels[[variable]]
>     bits <- as.integer(intToBits(as.integer(index)))[seq_along(levs)]
>     left_levels <- levs[bits == 1]
>     right_levels <- levs[bits == 0]
>     
>     out$type <- "factor"
>     out$left$levels <- left_levels
>     out$right$levels <- right_levels
>     out$left$condition <- paste0(variable, " %in% c(",
>                                  paste(sprintf('"%s"', left_levels), collapse = ", "),
>                                  ")")
>     out$right$condition <- paste0(variable, " %in% c(",
>                                   paste(sprintf('"%s"', right_levels), collapse = ", "),
>                                   ")")
>   }
>   
>   out
> }
> ```
> 
> That version is better if you want to use the result programmatically rather than just print it.
> 
