>     ) -> str: ...
> 
>     def stream_response(
>         self,
>         messages: list[Mapping[str, Any]],
>         max_tokens: int | None = None,
>     ): ...
> 
>     def allowed(self, tokens: int) -> bool: ...
> 
> 
> @dataclass(frozen=True)
> class RegisteredModel:
