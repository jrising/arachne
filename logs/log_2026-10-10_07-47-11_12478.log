> """
> Shared, version-aware registry for models, tools, plans, and plan templates.
> 
> Registry entries are registered once and then referenced by stable IDs and
> versions. The registry contains capability metadata; it does not execute
> providers and does not decide which plan to use.
> """
> 
> from __future__ import annotations
> 
> from dataclasses import dataclass
> from threading import RLock
> from types import MappingProxyType
> from typing import Any, Callable, Mapping, Protocol
> 
> from .types import ModelSpec, PlanSpec, PlannerContext, ToolConfig, ToolSpec
> 
> 
> class ModelAdapter(Protocol):
