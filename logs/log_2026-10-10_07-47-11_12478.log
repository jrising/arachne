>         options: Mapping[str, Sequence[Any]],
>         context: PlannerContext,
>         tool_name: str,
>     ) -> str | None:
>         strategies = tuple(options.get("strategy", ()))
>         if not strategies:
>             return None
> 
>         # Deterministic per request: reproducible and avoids global random state.
>         payload = json.dumps({
>             "conversation_id": context.conversation_id,
