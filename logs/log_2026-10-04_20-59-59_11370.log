>     verbosity: str | None = None
> 
>     # Preserve the old per-million-token pricing default.
>     input_cost_per_million: float = 2.50
>     output_cost_per_million: float = 10.00
> 
>     token_in_count: int = field(default=0, init=False)
>     token_out_count: int = field(default=0, init=False)
>     _lock: threading.Lock = field(default_factory=threading.Lock, init=False)
> 
>     @classmethod
>     def from_env(cls, provider_model_name: str, **kwargs: Any) -> "OpenAIAdapter":
>         """Construct an adapter using OPENAI_API_KEY."""
>         load_dotenv()
>         return cls(
>             client=OpenAI(api_key=os.getenv("OPENAI_API_KEY")),
>             provider_model_name=provider_model_name,
>             **kwargs,
>         )
> 
>     def fillin_training_end(
>         self,
>         messages: Sequence[Mapping[str, Any]],
>     ) -> list[dict[str, Any]]:
>         """Return a copy with TRAINING_END replaced in the first message."""
>         result = deepcopy(list(messages))
>         if not result:
>             return result
> 
>         content = result[0].get("content")
>         if isinstance(content, str):
>             result[0]["content"] = content.replace(
>                 "TRAINING_END",
>                 TRAINING_END.get(self.provider_model_name, "2021-09"),
>             )
>         return result
> 
>     def _record_input(self, messages: Sequence[Mapping[str, Any]]) -> None:
>         with self._lock:
>             self.token_in_count += budget.chat_tokens(messages)
> 
>     def _record_output(self, tokens: int | None) -> None:
>         if tokens is not None:
>             with self._lock:
>                 self.token_out_count += tokens
> 
>     def _request_kwargs(
>         self,
>         messages: Sequence[Mapping[str, Any]],
>         max_tokens: int | None,
>         *,
>         stream: bool,
>     ) -> dict[str, Any]:
>         kwargs: dict[str, Any] = {
>             "model": self.provider_model_name,
>             "messages": self.fillin_training_end(messages),
>             "stream": stream,
>             "temperature": self.temperature,
>             "max_completion_tokens": (
>                 self.default_max_tokens if max_tokens is None else max_tokens
>             ),
>         }
>         if self.verbosity is not None:
>             kwargs["verbosity"] = self.verbosity
>         return kwargs
> 
>     def chat_response(
>         self,
>         messages: Sequence[Mapping[str, Any]],
>         max_tokens: int | None = None,
>     ) -> str:
>         """Return one complete assistant response and account for its tokens."""
>         self._record_input(messages)
>         completion = self.client.chat.completions.create(
>             **self._request_kwargs(messages, max_tokens, stream=False)
>         )
> 
>         self._record_output(getattr(completion.usage, "completion_tokens", None))
>         return completion.choices[0].message.content or ""
> 
>     def stream_response(
>         self,
>         messages: Sequence[Mapping[str, Any]],
>         max_tokens: int | None = None,
>     ) -> Iterator[str]:
>         """Yield response fragments and account for input/output tokens."""
>         self._record_input(messages)
> 
>         stream = self.client.chat.completions.create(
>             **self._request_kwargs(messages, max_tokens, stream=True),
>             stream_options={"include_usage": True},
>         )
> 
>         # OpenAI sends final usage in a chunk with no choices.
>         fallback_chunk_count = 0
>         reported_output_tokens: int | None = None
> 
>         for chunk in stream:
>             usage = getattr(chunk, "usage", None)
>             if usage is not None:
>                 reported_output_tokens = getattr(usage, "completion_tokens", None)
> 
>             choices = getattr(chunk, "choices", None) or []
>             if not choices:
>                 continue
> 
>             content = getattr(choices[0].delta, "content", None)
>             if content:
>                 fallback_chunk_count += 1
>                 yield content
> 
>         # Preserve the former approximate behavior when final usage is absent.
>         self._record_output(
>             reported_output_tokens
>             if reported_output_tokens is not None
>             else fallback_chunk_count
>         )
> 
>     def chat_response_nobudget(
>         self,
>         messages: Sequence[Mapping[str, Any]],
>         max_tokens: int | None = None,
>     ) -> str:
>         """Compatibility method: make a request without updating counters."""
>         completion = self.client.chat.completions.create(
>             **self._request_kwargs(messages, max_tokens, stream=False)
>         )
>         return completion.choices[0].message.content or ""
> 
>     def allowed(self, tokens: int) -> bool:
>         """Hook for external budget enforcement; presently unrestricted."""
>         return True
> 
>     def estimate_cost(
>         self,
>         prompt_tokens: int,
>         completion_tokens: int,
>     ) -> float:
>         return (
>             self.input_cost_per_million * prompt_tokens / 1_000_000
>             + self.output_cost_per_million * completion_tokens / 1_000_000
>         )
> 
>     # Legacy name retained for callers using adapter.cost(...).
>     cost = estimate_cost
