> # ---------------------------------------------------------------------------
> # Temporary compatibility facade for existing `from ... import stream_response`
> # callers. New planner code should instantiate/register OpenAIAdapter directly.
> # ---------------------------------------------------------------------------
> 
> _default_chat_adapter = OpenAIAdapter.from_env("gpt-5.4-nano")
> _default_stream_adapter = OpenAIAdapter.from_env(
>     "gpt-5.6-terra",
>     default_max_tokens=3000,
>     verbosity="low",
> )
> 
> 
> def fillin_training_end(messages: Sequence[Mapping[str, Any]], model: str):
>     return OpenAIAdapter(
>         client=_default_chat_adapter.client,
>         provider_model_name=model,
>     ).fillin_training_end(messages)
> 
> 
> def single_prompt(prompt: str, system_message: str | None = None) -> str:
>     if system_message is None:
>         system_message = (
>             'You are a helpful, super-intelligent AI assistant, called '
