> class BaseResponder:
>     """Shared execution and measurement helpers."""
> 
>     def __init__(
>         self,
>         *,
>         message_builder: MessageBuilder | None = None,
>         completion_token_default: int = 512,
>     ) -> None:
>         self.message_builder = message_builder or self._default_messages
>         self.completion_token_default = completion_token_default
> 
>     def prepare(
>             self,
>             plan: PlanSpec,
>             context: PlannerContext,
>             max_tokens: int | None,
>     ) -> ResponseRecord:
>         return self._new_record(plan, context, max_tokens)
> 
> 
>     def _new_record(
>         self,
>         plan: PlanSpec,
>         context: PlannerContext,
>         max_tokens: int | None,
>     ) -> ResponseRecord:
>         messages = self.message_builder(plan, context)
>         prompt_tokens = self._estimate_tokens(messages)
>         completion_tokens = max_tokens or self.completion_token_default
> 
>         record = ResponseRecord(
>             response_id=str(uuid.uuid4()),
>             conversation_id=str(context.metadata.get("conversation_id", "")),
>             turn_id=context.metadata.get("turn_id"),
>             plan_id=plan.plan_id,
>             plan_version=plan.version,
>             model_id=plan.model_id,
>             started_at=time.time(),
>             decision_features=tuple(context.metadata.get("decision_features", ())),
>         )
>         metrics = MetricsTracker(record)
>         metrics.set_prompt_tokens(prompt_tokens)
>         return record
> 
>     @staticmethod
>     def _default_messages(
>         plan: PlanSpec,
>         context: PlannerContext,
>     ) -> list[dict[str, Any]]:
>         """
>         Transitional default until context.py owns effective-message assembly.
> 
>         New callers should place canonical messages in ``context.metadata`` as
>         ``messages``. `history_list_raw_data` is retained for compatibility.
>         """
>         supplied = context.metadata.get("messages")
>         if supplied is not None:
>             if not isinstance(supplied, Sequence):
>                 raise TypeError("context.metadata['messages'] must be a sequence.")
>             return [dict(message) for message in supplied]
> 
>         if context.history_list_raw_data:
>             return [{"role": "user", "content": context.history_list_raw_data}]
>         return []
> 
>     @staticmethod
>     def _estimate_tokens(value: Any) -> int:
>         """Deliberately rough fallback; replace with provider-aware accounting."""
>         return max(1, len(json.dumps(value, default=str)) // 4)
> 
>     @staticmethod
>     def _finish_record(
>         record: ResponseRecord,
>         *,
>         text: str | None = None,
>         error: Exception | None = None,
>     ) -> None:
>         metrics = MetricsTracker(record)
>         if error is not None:
>             metrics.fail(error)
>         else:
>             metrics.set_completion_tokens(BaseResponder._estimate_tokens(text or ""))
>             metrics.complete(visible_text=text or "")
>         
>     @staticmethod
>     def _estimated_model_cost(
>         registry: "Registry",
>         plan: PlanSpec,
>         record: ResponseRecord,
>     ) -> float | None:
>         if plan.model_id is None:
>             return None
> 
>         model = registry.get_model_spec(plan.model_id, plan.model_version)
>         if model.cost_per_million_tokens is None:
>             return None
> 
>         total = (record.prompt_tokens or 0) + (record.completion_tokens or 0)
>         return total * model.cost_per_million_tokens / 1_000_000
> 
> 
> class LLMResponder(BaseResponder):
>     """Direct execution through a registered model adapter."""
> 
>     def chat_response(
>         self,
>         plan: PlanSpec,
>         context: PlannerContext,
>         registry: "Registry",
>         *,
>         record: ResponseRecord,
>         max_tokens: int | None = None,
>     ) -> Response:
>         if plan.model_id is None:
>             raise ValueError("LLMResponder requires a plan with model_id.")
> 
>         model = registry.get_model(plan.model_id, plan.model_version)
>         messages = self.message_builder(plan, context)
> 
>         metrics = MetricsTracker(record)
>         metrics.add_model_call()
>         
>         try:
>             text = model.adapter.chat_response(messages, max_tokens=max_tokens)
>             research_plan = None
>             if plan.template_id == "direct_with_plan":
>                 text, research_plan = _split_research_plan(text)
> 
>             self._finish_record(record, text=text)
>             metrics.add_estimated_cost(self._estimated_model_cost(registry, plan, record))
>             return Response(id=record.response_id, text=text,
>                             model=plan.model_id, research_plan=research_plan)
>         except Exception as exc:
>             self._finish_record(record, error=exc)
>             raise ResponderExecutionError("Model response failed.", record) from exc
> 
>     def stream_response(
>         self,
>         plan: PlanSpec,
>         context: PlannerContext,
>         registry: "Registry",
>         *,
>         record: ResponseRecord,
>         max_tokens: int | None = None,
>     ) -> StreamResponse:
>         if plan.model_id is None:
>             raise ValueError("LLMResponder requires a plan with model_id.")
> 
>         # The record exists before the first visible chunk is yielded.
>         model = registry.get_model(plan.model_id, plan.model_version)
>         messages = self.message_builder(plan, context)
> 
>         metrics = MetricsTracker(record)
>         metrics.add_model_call()
> 
>         def chunks() -> Iterator[str]:
>             emitted: list[str] = []
>             try:
>                 for chunk in model.adapter.stream_response(messages, max_tokens=max_tokens):
>                     if chunk:
>                         if not record.visible_output_started:
>                             metrics.mark_visible_output_started()
>                         emitted.append(chunk)
>                         yield chunk
> 
>                 self._finish_record(record, text="".join(emitted))
>             except Exception as exc:
>                 self._finish_record(record, error=exc)
>                 # Planner must persist `record`; it must not retry if output began.
>                 raise ResponderExecutionError("Model stream failed.", record) from exc
> 
>         return StreamResponse(id=record.response_id, chunks=chunks(), model=plan.model_id)
> 
