> class JavaScriptPlanningResponder(LLMResponder):
>     """
>     Produce a visible answer plus an optional bounded JavaScript execution plan.
> 
>     The visible answer is returned immediately by the normal synchronous API;
>     any plan is executed synchronously in v1 and recorded as an ExecutionRun.
>     """
> 
>     def __init__(
>         self,
>         *,
>         runtime: JavaScriptRuntime,
>         repository,
>         **kwargs,
>     ) -> None:
>         super().__init__(**kwargs)
>         self.runtime = runtime
>         self.repository = repository
> 
>     def chat_response(
>         self,
>         plan: PlanSpec,
>         context: PlannerContext,
>         registry: "Registry",
>         *,
>         record: ResponseRecord,
>         max_tokens: int | None = None,
>     ) -> Response:
>         # This executes the planning-model call and completes model metrics.
>         response = super().chat_response(
>             plan,
>             context,
>             registry,
>             record=record,
>             max_tokens=max_tokens,
>         )
> 
>         visible_text, javascript_plan = extract_plan(response.text)
>         response.text = visible_text
>         record.visible_text = visible_text
> 
>         if javascript_plan is None:
>             return response
> 
>         run = ExecutionRun(
>             id=str(uuid.uuid4()),
>             response_id=record.response_id,
>             parent_run_id=None,
>             source="planner_model",
>             started_at=time.time(),
>             status="pending",
