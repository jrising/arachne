> // One JSON request on stdin; one JSON response on stdout.
> const requestText = await new Response(Deno.stdin.readable).text();
> const request = JSON.parse(requestText);
> const hostDeno = Deno; // Retained only by trusted worker code.
> 
> function respond(payload) {
>   const encoded = JSON.stringify(payload);
>   if (new TextEncoder().encode(encoded).byteLength > request.max_output_bytes) {
>     throw new Error("Worker response exceeds max_output_bytes.");
>   }
>   return hostDeno.stdout.write(new TextEncoder().encode(encoded));
> }
> 
> try {
>   // Plans run in a fresh subprocess. Remove convenient access to Deno and
>   // suppress accidental console output, preserving stdout for protocol JSON.
>   Object.defineProperty(globalThis, "Deno", {
>     value: undefined, writable: false, configurable: false,
>   });
>   Object.defineProperty(globalThis, "console", {
>     value: Object.freeze({
>       log() {}, info() {}, warn() {}, error() {}, debug() {},
>     }),
>     writable: false, configurable: false,
>   });
> 
>   const AsyncFunction = Object.getPrototypeOf(async function () {}).constructor;
>   const execute = new AsyncFunction(
>     "input",
>     `"use strict";\n${request.source}\nreturn await main(input);`,
>   );
> 
>   const result = await execute(request.input);
> 
>   // Reject undefined, functions, BigInt, cycles, etc. rather than silently
>   // producing ambiguous or lossy output.
>   const resultJson = JSON.stringify(result);
>   if (resultJson === undefined) {
>     throw new Error("Plan result must be JSON-serializable and not undefined.");
>   }
> 
>   await respond({ ok: true, result: JSON.parse(resultJson) });
> } catch (error) {
>   await respond({
>     ok: false,
>     error: {
>       type: error?.name || "JavaScriptError",
>       message: String(error?.message || error),
>     },
>   });
> }
