> class PlanStreamSplitter:
>     """
>     Stream visible text while withholding an optional terminal ```plan footer.
> 
>     Only a fence at the beginning of a line is treated as a plan. Whitespace
>     immediately preceding a recognized plan is withheld, so the visible output
>     has the same `.rstrip()` behavior as `extract_plan()`.
>     """
> 
>     _FENCE_PREFIX = "```plan"
> 
>     def __init__(self) -> None:
>         self._visible_parts: list[str] = []
>         self._pending_whitespace = ""
>         self._candidate = ""
>         self._candidate_state = "normal"
>         self._plan_parts: list[str] = []
>         self._line_start = True
>         self._finished = False
> 
>     @property
>     def visible_text(self) -> str:
>         return "".join(self._visible_parts)
> 
>     def feed(self, chunk: str) -> Iterator[str]:
>         if self._finished:
>             raise RuntimeError("Cannot feed a finished PlanStreamSplitter.")
>         if not isinstance(chunk, str):
>             raise TypeError("Stream chunks must be strings.")
> 
>         emitted: list[str] = []
> 
>         for char in chunk:
>             self._consume(char, emitted)
> 
>         yield from emitted
> 
>     def finish(self) -> tuple[str, JavaScriptPlan | None]:
>         """Flush visible text or validate and return the withheld terminal plan."""
>         if self._finished:
>             raise RuntimeError("PlanStreamSplitter.finish() may only be called once.")
>         self._finished = True
> 
>         if self._candidate_state != "normal":
>             self._emit(
>                 self._pending_whitespace + self._candidate,
>                 output=None,
>             )
>             self._pending_whitespace = ""
>             self._candidate = ""
>             self._candidate_state = "normal"
> 
>         if not self._plan_parts:
>             self._emit(self._pending_whitespace, output=None)
>             self._pending_whitespace = ""
>             return self.visible_text, None
> 
>         # Reuse the canonical parser/validator. Any content after the closing
>         # fence causes rejection because plans must be terminal footers.
>         _, plan = extract_plan("```plan\n" + "".join(self._plan_parts))
>         if plan is None:  # Defensive; extract_plan should either return a plan or raise.
>             raise ValueError("Incomplete JavaScript plan footer.")
>         return self.visible_text, plan
> 
>     def _consume(self, char: str, output: list[str]) -> None:
>         if self._candidate_state == "in_plan":
>             self._plan_parts.append(char)
>             return
> 
>         if self._candidate_state == "header_tail":
>             if char in " \t":
>                 self._candidate += char
>                 return
>             if char == "\n":
>                 self._candidate_state = "in_plan"
>                 self._candidate = ""
>                 self._pending_whitespace = ""
>                 return
>             if char == "\r":
>                 self._candidate += char
>                 self._candidate_state = "header_cr"
>                 return
>             self._reject_candidate(output)
>             return
> 
>         if self._candidate_state == "header_cr":
>             if char == "\n":
>                 self._candidate_state = "in_plan"
>                 self._candidate = ""
>                 self._pending_whitespace = ""
>                 return
>             self._reject_candidate(output)
>             return
> 
>         if self._candidate_state == "fence":
>             self._candidate += char
>             if self._FENCE_PREFIX.startswith(self._candidate):
>                 if self._candidate == self._FENCE_PREFIX:
>                     self._candidate_state = "header_tail"
>                 return
>             self._reject_candidate(output)
>             return
> 
>         # Normal visible-text state.
>         if char.isspace():
>             self._pending_whitespace += char
>             return
> 
>         at_fence_position = (
>             (self._line_start and not self._pending_whitespace)
>             or self._pending_whitespace.endswith("\n")
>         )
>         if char == "`" and at_fence_position:
>             self._candidate = char
>             self._candidate_state = "fence"
>             return
> 
>         self._emit(self._pending_whitespace + char, output)
>         self._pending_whitespace = ""
> 
>     def _reject_candidate(self, output: list[str]) -> None:
>         self._emit(self._pending_whitespace + self._candidate, output)
>         self._pending_whitespace = ""
>         self._candidate = ""
>         self._candidate_state = "normal"
> 
>     def _emit(self, text: str, output: list[str] | None) -> None:
>         if not text:
>             return
>         self._visible_parts.append(text)
>         self._line_start = text.endswith("\n")
>         if output is not None:
>             output.append(text)
