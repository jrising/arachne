>         return nothing, "failure: $(sprint(showerror, e)); see $logfile"
>     finally
>         rm(out; force=true)
>         rm(contextpath; force=true)
>     end
> end
> ```
> 
> ## 2. Add prepared-context methods
> 
> ```julia
> """
> Run every context script needed by active pool models exactly once.
> 
> The result may be reused for multiple `poolprice(nday, prepared)` calls.
> """
> function prepare_pool_context()
>     s = state()
>     active = filter(m -> m["status"] != "archived", models(s))
> 
>     required = Set{String}()
>     for m in active
>         union!(required, get(m, "contexts", String[]))
>     end
> 
>     scripts = Dict(c["name"] => c for c in contextscripts(s))
>     additions = Dict{String,Any}()
>     errors = Dict{String,String}()
> 
>     for name in required
>         if !haskey(scripts, name)
>             errors[name] = "Context script is registered by a model but unavailable."
>             continue
>         end
> 
>         addition, err = runcontextscript(scripts[name]; timeout=60)
>         if err === nothing
>             additions[name] = addition
>         else
>             errors[name] = err
>         end
>     end
> 
>     return Dict(
>         "prepared_at" => string(now()),
>         "base_context" => deserialize(BASE_CONTEXT),
>         "additions" => additions,
>         "errors" => errors
>     )
> end
> 
> """
> Build the specific context visible to one model.
> 
> If multiple declared scripts define the same key, the later script in
> `m["contexts"]` wins.
> """
> function context_for_model(m, prepared)
>     context = deepcopy(prepared["base_context"])
> 
>     for name in get(m, "contexts", String[])
>         if haskey(prepared["errors"], name)
>             return nothing, "required context script '$name' failed: " *
>                             prepared["errors"][name]
>         end
> 
>         if !haskey(prepared["additions"], name)
>             return nothing, "required context script '$name' produced no result"
>         end
> 
>         addition = prepared["additions"][name]
>         addition isa AbstractDict ||
>             return nothing, "context script '$name' did not return a dictionary"
> 
>         merge!(context, addition)
>     end
> 
>     return context, nothing
> end
> ```
> 
> ## 3. Replace `poolprice`
> 
> ```julia
> function poolprice(nday::Int, prepared=prepare_pool_context())
>     s = state()
>     ms = filter(m -> m["status"] != "archived", models(s))
> 
>     individual = Dict{String,Dict{String,Vector{Float64}}}()
>     errors = Dict{String,String}()
> 
>     for m in ms
>         context, contexterr = context_for_model(m, prepared)
> 
>         if contexterr !== nothing
>             errors[m["id"]] = contexterr
>             continue
>         end
> 
>         pred, err = runmodel(m, nday, context; timeout=60)
>         if err !== nothing
>             errors[m["id"]] = err
>         else
>             individual[m["id"]] = pred
>         end
>     end
> 
>     scores = scoretable(s)
>     validated = filter(m -> m["status"] == "validated", ms)
>     ws = weights(validated, scores, s["temperature"])
>     pooled = Dict{String,Vector{Float64}}()
> 
>     tickers = Set{String}()
>     for m in validated
>         haskey(individual, m["id"]) || continue
>         union!(tickers, keys(individual[m["id"]]))
>     end
> 
>     for ticker in tickers
>         relevant = [m for m in validated if
>             haskey(individual, m["id"]) &&
>             haskey(individual[m["id"]], ticker)]
> 
>         isempty(relevant) && continue
> 
>         ix = [findfirst(x -> x["id"] == m["id"], validated) for m in relevant]
>         rw = copy(ws[ix])
>         rw ./= sum(rw)
> 
>         draws = Float64[]
>         for _ in 1:5
>             j = sample(1:length(relevant), Weights(rw))
>             push!(draws, rand(individual[relevant[j]["id"]][ticker]))
>         end
>         pooled[ticker] = draws
>     end
> 
>     serialize(joinpath(PREDS, "$(uuid4()).bin"), Dict(
>         "date" => today(),
>         "target" => forecast_target(nday),
>         "sigma_floor" => s["sigma_floor"],
>         "individual" => individual,
>         "pooled" => pooled,
>         "errors" => errors,
>         "weights" => Dict(m["id"] => w for (m, w) in zip(validated, ws)),
>         "prepared_context_at" => prepared["prepared_at"]
>     ))
> 
>     return pooled
> end
> ```
> 
> ## Usage
> 
> ```julia
> prepared = PoolPredict.prepare_pool_context()
> 
> poolprices = cat(
>     [PoolPredict.poolprice(nday, prepared) for nday in 1:7]...,
>     dims=3
> )
> ```
> 
> More likely, since each result is a ticker-keyed dictionary:
> 
> ```julia
> prepared = PoolPredict.prepare_pool_context()
> poolprices = Dict(nday => PoolPredict.poolprice(nday, prepared) for nday in 1:7)
> ```
> 
> This runs each required context script once, while every algorithm receives an independent merged copy of the base context.
