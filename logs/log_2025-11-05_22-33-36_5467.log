>   beta <- 1.0 / temp
>   lattice <- matrix(sample(c(-1, 1), lattice_size^2, replace = TRUE),
>                     nrow = lattice_size, ncol = lattice_size)
>   
>   # Function to calculate energy change
>   energy_change <- function(lattice, i, j) {
>     right <- ifelse(j == ncol(lattice), 1, j + 1)
>     left  <- ifelse(j == 1, ncol(lattice), j - 1)
>     up    <- ifelse(i == 1, nrow(lattice), i - 1)
>     down  <- ifelse(i == nrow(lattice), 1, i + 1)
>     
>     neighbors_sum <- lattice[i, right] + lattice[i, left] +
>                      lattice[up, j] + lattice[down, j]
>     
>     return(2 * J * lattice[i, j] * neighbors_sum)
>   }
>   
>   # Metropolis algorithm
>   for (step in seq_len(steps)) {
>     i <- sample(1:lattice_size, 1)
>     j <- sample(1:lattice_size, 1)
>     
>     delta_E <- energy_change(lattice, i, j)
>     if (delta_E < 0 || runif(1) < exp(-beta * delta_E)) {
>       lattice[i, j] <- -lattice[i, j]
>     }
>   }
>   
>   return(lattice)
> }
> 
> # Run the simulation and visualize
> result <- ising_model(lattice_size = 10, temp = 2.0, steps = 10000)
> image(result, col = c("black", "white"), main = "Ising Model Simulation")
> ```
> 
> This adjustment ensures that any index that would exceed the dimensions of the lattice wraps around correctly, maintaining the periodic boundary conditions characteristic of many Ising model simulations. Thank you for pointing out that important detail!
