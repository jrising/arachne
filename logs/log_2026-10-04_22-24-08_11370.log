**user**:
> We have made an initial implementation of a new "planning" logic for responding to queries. Here is the current code, which includes many classes that will be implemented in a future version:
> 
> =====
> planner/metrics.py
> """
> Token, cost, latency, availability, and failure measurement.
> 
> All estimates are explicit and revisable. Observed provider usage should
> eventually supersede static provider price estimates.
> """
> from __future__ import annotations
> 
> from contextlib import contextmanager
> import time
> from typing import Iterator
> 
> from .types import ResponseRecord
> 
> 
> class MetricsTracker:
>     """The sole mutation interface for response lifecycle measurements."""
> 
>     def __init__(self, record: ResponseRecord) -> None:
>         self.record = record
> 
>     def set_prompt_tokens(self, tokens: int) -> None:
>         self.record.metrics.prompt_tokens = max(0, tokens)
> 
>     def set_completion_tokens(self, tokens: int) -> None:
>         self.record.metrics.completion_tokens = max(0, tokens)
> 
>     def add_model_call(self) -> None:
>         self.record.metrics.model_call_count += 1
> 
>     def add_tool_call(self, *, failed: bool = False) -> None:
>         self.record.metrics.tool_call_count += 1
>         self.record.metrics.tool_failure_count += int(failed)
> 
>     def add_estimated_cost(self, cost: float | None) -> None:
>         if cost is not None:
>             self.record.metrics.estimated_cost_usd = (
>                 (self.record.metrics.estimated_cost_usd or 0.0) + max(0.0, cost)
>             )
> 
>     def add_observed_cost(self, cost: float | None) -> None:
>         if cost is not None:
>             self.record.metrics.observed_cost_usd = (
>                 (self.record.metrics.observed_cost_usd or 0.0) + max(0.0, cost)
>             )
> 
>     def mark_visible_output_started(self) -> None:
>         self.record.visible_output_started = True
> 
>     def complete(self, *, visible_text: str = "") -> None:
>         self.record.visible_text = visible_text
>         self.record.completed_at = time.time()
>         self.record.metrics.latency_s = (
>             self.record.completed_at - self.record.started_at
>         )
>         self.record.status = "completed"
> 
>     def fail(self, exc: Exception) -> None:
>         self.record.completed_at = time.time()
>         self.record.metrics.latency_s = (
>             self.record.completed_at - self.record.started_at
>         )
>         self.record.status = "failed"
>         self.record.error = f"{type(exc).__name__}: {exc}"
> 
>     def cancel(self) -> None:
>         self.record.completed_at = time.time()
>         self.record.metrics.latency_s = (
>             self.record.completed_at - self.record.started_at
>         )
>         self.record.status = "cancelled"
> 
> 
> @contextmanager
> def measure_latency() -> Iterator[callable]:
>     started = time.monotonic()
>     yield lambda: time.monotonic() - started
> 
