> ## Now let's model it!
> library(MASS)
> library(reshape2)
> random_draws_from_lm <- function(mod, new_data, N, include.intercept=T, random_params=NULL) {
>     ## Coefficients and covariance matrix
>     coefs <- coef(mod)
>     if (is.null(random_params)) {
>         vcov_matrix <- vcov(mod)
> 
>         ## Draw N samples from a multivariate normal distribution
>         random_params <- mvrnorm(n=N, mu=coefs, Sigma=vcov_matrix)
>     }
> 
>     ## Add an intercept term to new_data if needed
>     if (include.intercept) {
