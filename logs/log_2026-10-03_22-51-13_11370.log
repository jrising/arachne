> def query_features(messages: Sequence[Mapping]) -> tuple[str, ...]:
>     user_text = " ".join(
>         str(m.get("content", "")).lower()
>         for m in messages if m.get("role") == "user"
>     )
>     words = set(re.findall(r"[a-z]{3,}", user_text))
>     features = {f"word:{w}" for w in words & _WORDS}
> 
>     if _YEAR.search(user_text):
>         features.add("has_year")
>     if any(x in user_text for x in ("latest", "current", "today", "recent")):
>         features.add("freshness")
>     if any(x in user_text for x in ("cite", "source", "evidence", "research")):
>         features.add("grounding_requested")
>     if "?" in user_text:
>         features.add("question")
>     if len(user_text) > 500:
>         features.add("long_query")
> 
>     return tuple(sorted(features))
> 
> def _cue_bonus(plan: PlanSpec, features: set[str]) -> float:
>     mode = plan.metadata.get("execution_mode")
> 
>     if mode == "direct":
>         bonus = 0.15
>         if {"freshness", "grounding_requested"} & features:
>             bonus -= 0.35
>         return bonus
> 
>     if mode == "rag":
>         bonus = 0.0
>         if "grounding_requested" in features:
>             bonus += 0.45
>         if "freshness" in features:
>             bonus += 0.35
>         if "has_year" in features:
>             bonus += 0.10
>         return bonus
> 
>     if mode == "parallel":
>         # Best where research seems likely but not certain.
>         return 0.20 if (
>             "freshness" in features or "grounding_requested" in features
>         ) else -0.15
> 
>     return 0.0
