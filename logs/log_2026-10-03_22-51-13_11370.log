> const hostDeno = Deno;
> const encoder = new TextEncoder();
> const decoder = new TextDecoder();
> 
> let writeChain = Promise.resolve();
> function send(message) {
>   const line = JSON.stringify(message) + "\n";
>   writeChain = writeChain.then(() => hostDeno.stdout.write(encoder.encode(line)));
>   return writeChain;
> }
> 
> async function* lines() {
>   const reader = hostDeno.stdin.readable.getReader();
>   let buffered = "";
>   try {
>     for (;;) {
>       const { value, done } = await reader.read();
>       if (done) break;
>       buffered += decoder.decode(value, { stream: true });
>       let index;
>       while ((index = buffered.indexOf("\n")) >= 0) {
>         yield buffered.slice(0, index).replace(/\r$/, "");
>         buffered = buffered.slice(index + 1);
>       }
>     }
>     if (buffered) yield buffered;
>   } finally {
>     reader.releaseLock();
>   }
> }
> 
> const incoming = lines();
> const first = await incoming.next();
> if (first.done) throw new Error("Missing execution.start request.");
> 
> const start = JSON.parse(first.value);
> if (
>   start.jsonrpc !== "2.0" ||
>   start.method !== "execution.start" ||
>   !start.id
> ) {
>   throw new Error("Expected execution.start JSON-RPC request.");
> }
> 
> const pending = new Map();
> (async () => {
>   for await (const line of incoming) {
>     const message = JSON.parse(line);
>     if (message.jsonrpc !== "2.0" || !message.id) continue;
> 
>     const waiter = pending.get(message.id);
>     if (!waiter) continue;
>     pending.delete(message.id);
> 
>     if (message.error) waiter.reject(new Error(message.error.message));
>     else waiter.resolve(message.result);
>   }
> })();
> 
> let callNumber = 0;
> function hostCall(method, params) {
>   const id = `call-${++callNumber}`;
>   return new Promise((resolve, reject) => {
>     pending.set(id, { resolve, reject });
>     send({ jsonrpc: "2.0", id, method, params }).catch(reject);
>   });
> }
> 
> const exposed = new Set(start.params.tools || []);
> const tools = new Proxy({}, {
>   get(_target, name) {
>     if (typeof name !== "string" || !exposed.has(name)) {
>       throw new Error(`Unknown JavaScript tool: ${String(name)}`);
>     }
>     return async (arguments_) => {
>       if (!arguments_ || Array.isArray(arguments_) || typeof arguments_ !== "object") {
>         throw new Error("Tool arguments must be an object.");
>       }
>       return hostCall("tool.call", { name, arguments: arguments_ });
>     };
>   },
> });
> 
> async function parallelMap(items, options, fn) {
>   if (!Array.isArray(items)) throw new Error("parallelMap items must be an array.");
>   const concurrency = options?.concurrency;
>   if (!Number.isInteger(concurrency) || concurrency < 1 || concurrency > 8) {
>     throw new Error("parallelMap concurrency must be an integer from 1 through 8.");
>   }
> 
>   const result = new Array(items.length);
>   let next = 0;
>   async function worker() {
>     while (true) {
>       const index = next++;
>       if (index >= items.length) return;
>       result[index] = await fn(items[index], index);
>     }
>   }
>   await Promise.all(Array.from(
>     { length: Math.min(concurrency, items.length) },
>     worker,
>   ));
>   return result;
> }
> 
> async function retry(options, fn) {
>   const attempts = options?.attempts;
>   if (!Number.isInteger(attempts) || attempts < 1 || attempts > 3) {
>     throw new Error("retry attempts must be an integer from 1 through 3.");
>   }
> 
>   let error;
>   for (let attempt = 1; attempt <= attempts; attempt++) {
>     try {
>       return await fn(attempt);
>     } catch (caught) {
>       error = caught;
>     }
>   }
>   throw error;
