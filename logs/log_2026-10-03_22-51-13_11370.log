> class ThreeWaySelector(PlanSelector):
>     """
>     In-memory Beta-Bernoulli evidence. Persist these counts in evaluation/
>     persistence when moving beyond v1.
>     """
> 
>     def __init__(self, *args, learned_weight: float = 1.0, **kwargs):
>         super().__init__(*args, **kwargs)
>         self.learned_weight = learned_weight
>         self._evidence = defaultdict(lambda: [1.0, 1.0])  # (plan, feature) -> α, β
> 
>     def score_plan(self, plan, context, records):
>         score = super().score_plan(plan, context, records)
>         features = set(context.metadata.get("decision_features", ()))
>         score += _cue_bonus(plan, features)
>         
>         if not features:
>             return score
> 
>         # Mean posterior probability that this plan receives positive feedback
>         # for the active local cues; weak priors shrink sparse evidence to 0.5.
>         probabilities = []
>         for feature in features:
>             alpha, beta = self._evidence[(plan.plan_id, feature)]
>             probabilities.append(alpha / (alpha + beta))
> 
>         expected_success = sum(probabilities) / len(probabilities)
>         return score + self.learned_weight * (expected_success - 0.5)
> 
>     def observe(self, record: ResponseRecord, positive: bool) -> None:
>         for feature in record.decision_features:
>             alpha_beta = self._evidence[(record.plan_id, feature)]
>             alpha_beta[0 if positive else 1] += 1.0
