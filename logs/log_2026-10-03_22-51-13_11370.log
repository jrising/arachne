> planner/selection.py
> """
> Pure plan-selection policy.
> 
> This module chooses a PlanSpec for a PlannerContext from eligible candidates.
> It applies learned evidence, quality priors, cost, latency, reliability risk,
> availability, and constrained exploration. It never executes plans or mutates
> durable state during selection.
> 
> Conceptual utility:
> 
>     U(p | x) =
>         w_s * predicted_satisfaction
>       + w_q * predicted_quality
>       - w_c * expected_cost
>       - w_l * expected_latency
>       - w_r * expected_risk
>       + w_e * exploration_value
> 
> Quality, reliability, user satisfaction, and cost/latency must remain separate
> evidence streams. Do not allow cheap fluent plans to dominate solely because
> they collect positive thumbs.
> """
> 
> from __future__ import annotations
> 
> import hashlib
> import json
> import math
> import random
> from typing import Any, Mapping, Sequence
> 
> from .types import PlanSpec, PlannerContext, ResponseRecord
> 
> 
> DEFAULT_WEIGHTS: Mapping[str, float] = {
>     "satisfaction": 1.0,
>     "quality_prior": 0.5,
>     "cost": 100.0,
>     "latency": 0.1,
>     "risk": 1.0,
>     "exploration": 0.05,
> }
> 
> DEFAULT_PROMPT_TOKENS = 100
> DEFAULT_COMPLETION_TOKENS = 200
> DEFAULT_LATENCY_S = 5.0
> 
> # Beta(1, 1): neutral, deliberately weak prior.
> ALPHA_PRIOR_SUCCESS = 1.0
> BETA_PRIOR_FAILURE = 1.0
> 
> DEFAULT_HIGH_STAKES_EXPLORATION_LIMIT = 2.0
> 
> 
> class PlanSelector:
>     """Pure, deterministic-given-seed plan-selection policy."""
> 
>     def __init__(
>         self,
>         weights: Mapping[str, float] | None = None,
>         *,
>         random_seed: int | None = None,
>         high_stakes_exploration_limit: float = (
>             DEFAULT_HIGH_STAKES_EXPLORATION_LIMIT
>         ),
>     ) -> None:
>         self.weights = {**DEFAULT_WEIGHTS, **(weights or {})}
>         self._random_seed = random_seed
>         self.high_stakes_exploration_limit = max(
>             1.0, high_stakes_exploration_limit
>         )
> 
>     def score_plan(
>         self,
>         plan: PlanSpec,
>         context: PlannerContext,
>         records: Sequence[ResponseRecord],
>     ) -> float:
>         """Return utility for one plan, retaining evidence streams separately."""
>         plan_records = [r for r in records if r.plan_id == plan.plan_id and r.plan_version == plan.version]
> 
>         # Satisfaction: only explicit votes are evidence. "neutral"/"skipped"
>         # responses must not silently become failures.
>         votes = [r.satisfaction_outcome for r in plan_records if r.satisfaction_outcome in ("up", "down")]
>         ups = sum(outcome == "up" for outcome in votes)
>         satisfaction = (
>             ALPHA_PRIOR_SUCCESS + ups
>         ) / (ALPHA_PRIOR_SUCCESS + BETA_PRIOR_FAILURE + len(votes))
> 
>         # Quality remains an independently registered/offline-evaluated prior.
>         quality = _bounded(getattr(plan, "quality_prior", 0.5), default=0.5)
> 
>         # Reliability is separate from satisfaction. A downvote can indicate
>         # poor usefulness, while a failed operation is a concrete reliability event.
>         attempts = [
>             r for r in plan_records
>             if getattr(r, "status", "unknown") != "streaming"
>         ]
>         reliability_failures = sum(
>             getattr(r, "status", None) == "failed" for r in attempts
>         )
>         risk = (
>             BETA_PRIOR_FAILURE + reliability_failures
>         ) / (ALPHA_PRIOR_SUCCESS + BETA_PRIOR_FAILURE + len(attempts))
> 
>         observed_costs = [
>             cost for r in plan_records
>             if (cost := _record_cost(r)) is not None and cost >= 0
>         ]
>         cost = (
>             sum(observed_costs) / len(observed_costs)
>             if observed_costs
>             else _estimate_cost(plan, context)
>         )
> 
>         observed_latencies = [
>             latency for r in plan_records
>             if (latency := getattr(r, "latency_s", None)) is not None
>             and latency >= 0
>         ]
>         latency = (
>             sum(observed_latencies) / len(observed_latencies)
>             if observed_latencies
>             else max(0.0, getattr(plan, "estimated_latency_s", DEFAULT_LATENCY_S))
>         )
> 
>         # This is deliberately modest: uncertainty should permit exploration,
>         # not outweigh established quality or risk evidence.
>         exploration = 1.0 / math.sqrt(1.0 + len(plan_records))
> 
>         w = self.weights
>         return (
>             w["satisfaction"] * satisfaction
>             + w["quality_prior"] * quality
>             - w["cost"] * cost
>             - w["latency"] * latency
>             - w["risk"] * risk
>             + w["exploration"] * exploration
>         )
> 
>     def select_plan(
>         self,
>         context: PlannerContext,
>         candidate_plans: Sequence[PlanSpec],
>         past_response_records: Sequence[ResponseRecord] | None = None,
>     ) -> PlanSpec:
>         if not candidate_plans:
>             raise ValueError("No candidate plans provided.")
> 
>         records = past_response_records or ()
>         # Planner._plan_allowed has already applied dynamic availability,
>         # token-limit, and risk-policy checks.
>         eligible = list(candidate_plans)
> 
>         scores = [self.score_plan(plan, context, records) for plan in eligible]
> 
>         # Softmax preserves meaningful utility differences better than shifting
>         # scores into arbitrary positive roulette-wheel weights.
>         temperature = 1.0
>         if getattr(context, "is_high_stakes_task", False):
>             temperature /= self.high_stakes_exploration_limit
> 
>         probabilities = _softmax(scores, temperature=temperature)
> 
>         # A local RNG derived from stable inputs makes selection reproducible
>         # without mutable RNG state making identical requests vary unexpectedly.
>         rng = random.Random(
>             _selection_seed(
>                 self._random_seed,
>                 context,
>                 eligible,
>                 scores,
>                 records,
>             )
>         )
>         return rng.choices(eligible, weights=probabilities, k=1)[0]
> 
>     def update_weights(self, feedback: Any) -> None:
>         """Explicit hook for future externally-managed policy learning."""
>         # Weight learning belongs in evaluation/feedback infrastructure, not
>         # hidden selection-time mutation.
>         return None
> 
> 
> def _estimate_cost(plan: PlanSpec, context: PlannerContext) -> float:
>     return max(0.0, float(plan.metadata.get("estimated_cost_usd", 0.0)))
> 
> 
> def _record_cost(record: ResponseRecord) -> float | None:
>     """Accept the current and likely future ResponseRecord cost field names."""
>     for field in ("observed_cost_usd", "estimated_cost_usd",
>                   "cost_usd", "cost", "actual_cost_usd"):
>         value = getattr(record, field, None)
>         if value is not None:
>             return float(value)
>     return None
> 
> 
> def _bounded(value: Any, *, default: float) -> float:
>     try:
>         return min(1.0, max(0.0, float(value)))
>     except (TypeError, ValueError):
>         return default
> 
> 
> def _softmax(scores: Sequence[float], *, temperature: float) -> list[float]:
>     scaled = [score / max(temperature, 1e-9) for score in scores]
>     maximum = max(scaled)
>     weights = [math.exp(min(700.0, value - maximum)) for value in scaled]
>     total = sum(weights)
>     return [weight / total for weight in weights]
> 
> 
> def _selection_seed(
>     configured_seed: int | None,
>     context: PlannerContext,
>     plans: Sequence[PlanSpec],
>     scores: Sequence[float],
>     records: Sequence[ResponseRecord],
> ) -> int:
>     payload = {
>         "configured_seed": configured_seed,
>         "conversation_id": getattr(context, "conversation_id", None),
>         "plans": [
>             (plan.plan_id, plan.version, round(score, 12))
>             for plan, score in zip(plans, scores)
>         ],
>         "records": [
>             (
>                 record.response_id,
>                 record.plan_id,
>                 getattr(record, "outcome", None),
>                 getattr(record, "status", None),
>             )
>             for record in records
>         ],
>     }
>     digest = hashlib.sha256(
>         json.dumps(payload, sort_keys=True, default=str).encode()
>     ).digest()
>     return int.from_bytes(digest[:8], "big")
> 
