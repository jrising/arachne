>         if "defaults" in config or "options" in config or "version" in config:
>             return ToolConfig(
>                 defaults=dict(config.get("defaults", {})),
>                 options=dict(config.get("options", {})),
>                 version=str(config.get("version", "1")),
>             )
> 
>         # Convenience form: plain mapping is interpreted as defaults.
>         return ToolConfig(defaults=dict(config))
