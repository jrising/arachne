>   "Total costs" = c(NA, NA, "UK-wide")
> )
> 
> risk.options <- list(
>   "Hazards" = c("Local temperatures", "Sea-level rise"),
>   "Regional Risks" = c(
>     "Agricultural productivity", "All-source flooding",
>     "Heat-related mortality", "Labour productivity",
>     "Labour hours lost", "Coastal impacts"
>   ),
>   "National Risks" = c(
>     "Trade spill-overs", "Catastrophic risk",
>     "Missing risks", "Total costs"
>   )
> )
> 
> adaptation.options <- list(
>   "Agricultural productivity" = "Proportional to Benefits",
>   "Heat-related mortality" = c("Proportional to Benefits", "Air Conditioning", "Shutters"),
>   "Labour productivity & supply" = "Proportional to Benefits",
>   "All-source flooding" = "Proportional to Benefits",
>   "Coastal impacts" = "Proportional to Benefits"
> )
> 
> order_of_magnitude <- function(x) {
>   if (is.na(x) || x == 0) return(0)
>   floor(log10(abs(x)))
> }
> 
> format_estimate_with_ci <- function(mu, ci05, ci95, bold = "") {
>   if (is.na(mu)) return("No estimate")
> 
>   ci.range <- max(abs(ci95 - ci05), .Machine$double.eps)
>   digits <- max(0, -order_of_magnitude(ci.range) + 1)
> 
>   mu.txt <- format(round(mu, digits), nsmall = digits, trim = TRUE)
>   lo.txt <- format(floor(ci05 * 10^(digits - 1)) / 10^(digits - 1),
>                    nsmall = max(0, digits - 1), trim = TRUE)
>   hi.txt <- format(ceiling(ci95 * 10^(digits - 1)) / 10^(digits - 1),
>                    nsmall = max(0, digits - 1), trim = TRUE)
> 
>   if (bold == "mu") mu.txt <- paste0("<b>", mu.txt, "</b>")
>   if (bold == "ci05") lo.txt <- paste0("<b>", lo.txt, "</b>")
>   if (bold == "ci95") hi.txt <- paste0("<b>", hi.txt, "</b>")
> 
>   paste0(mu.txt, " [", lo.txt, " - ", hi.txt, "]")
> }
> 
> make_palette_info <- function(df) {
>   limits <- c(
>     quantile(df$ci05, .05, na.rm = TRUE),
>     quantile(df$ci95, .95, na.rm = TRUE)
>   )
> 
>   if (all(sign(df$ci05) == sign(df$ci95), na.rm = TRUE)) {
>     pal <- colorNumeric("YlOrRd", domain = limits,
>                         na.color = "transparent", reverse = FALSE)
>   } else {
>     domain <- c(-max(abs(limits)), max(abs(limits)))
>     pal <- colorNumeric("Spectral", domain = domain,
>                         na.color = "transparent", reverse = TRUE)
>   }
> 
>   list(limits = limits, palette = pal)
> }
> 
> read_risk_data <- function(channel) {
>   x <- read.csv(file.path("Dataset v2", datasets[[channel]]))
> 
>   if (channel == "Local temperatures") {
>     x[c("mu", "ci05", "ci95")] <- x[c("mu", "ci05", "ci95")] - 273.13
>   } else if (channel == "Coastal impacts") {
>     x[c("mu", "ci05", "ci95")] <- x[c("mu", "ci05", "ci95")] * 1000 * 1.5283
>   } else if (channel %in% c("Total costs", "Missing risks")) {
>     x[c("mu", "ci05", "ci95")] <- x[c("mu", "ci05", "ci95")] * 100
>   }
> 
>   x
> }
> 
> prepare_shape <- function(channel, raw.shape) {
>   spdf <- raw.shape
> 
>   reg.col <- dataset2region[[channel]][1]
>   name.col <- dataset2region[[channel]][3]
> 
>   if (!is.na(reg.col) && reg.col == "ISOADM1") {
>     spdf$ISOADM1 <- gsub("-", "", spdf$adm1_code)
>   }
> 
>   if (!is.na(reg.col) && reg.col == "locationax") {
>     pieces <- strsplit(spdf$locationna, " ")
>     spdf$locationax <- vapply(
>       pieces,
>       function(x) paste0(paste(x[-1], collapse = ""), x[1]),
>       character(1)
>     )
>   }
> 
>   if (name.col == "divaname") {
>     spdf$divaname <- vapply(spdf$locationid, function(id) {
>       found <- divanames$name[divanames$locationid == id]
>       if (length(found)) found[1] else ""
>     }, character(1))
>   }
> 
>   if (!"PID" %in% names(spdf)) spdf$PID <- seq_len(nrow(spdf))
> 
>   # Leaflet expects longitude/latitude.  Simplification greatly reduces payload.
>   spdf <- st_transform(spdf, 4326)
>   spdf <- st_simplify(spdf, dTolerance = 0.0015, preserveTopology = TRUE)
> 
>   keep <- unique(c("PID", reg.col, name.col, "geometry"))
>   keep <- keep[!is.na(keep) & keep %in% names(spdf)]
>   spdf[, keep]
> }
> 
> # ---- Application-wide immutable caches --------------------------------------
> # These load once per R process, rather than once per input update or user.
> risk.cache <- lapply(names(datasets), read_risk_data)
> names(risk.cache) <- names(datasets)
> 
> palette.cache <- lapply(risk.cache, make_palette_info)
> 
> raw.shapes <- lapply(unique(unname(regions)), function(f) {
>   st_read(f, quiet = TRUE)
> })
> names(raw.shapes) <- unique(unname(regions))
> 
> shape.cache <- lapply(names(regions), function(channel) {
>   prepare_shape(channel, raw.shapes[[regions[[channel]]]])
> })
> names(shape.cache) <- names(regions)
> 
> make_map_payload <- function(channel, scenario, measure, year, quant) {
>   df <- risk.cache[[channel]]
>   spdf <- shape.cache[[channel]]
>   cols <- dataset2region[[channel]]
>   reg.spdf <- cols[1]
>   reg.df <- cols[2]
>   name.spdf <- cols[3]
>   pal.info <- palette.cache[[channel]]
> 
>   sub <- df[
>     df$scenario == scenario &
>       df$measure == measure &
>       df$year == year,
>     ,
>     drop = FALSE
>   ]
> 
>   if (!is.na(reg.spdf)) {
>     index <- match(as.character(spdf[[reg.spdf]]), as.character(sub[[reg.df]]))
>     vals <- sub[index, c("mu", "ci05", "ci95"), drop = FALSE]
>     region.names <- as.character(spdf[[name.spdf]])
>   } else {
>     vals <- sub[rep(1, nrow(spdf)), c("mu", "ci05", "ci95"), drop = FALSE]
>     region.names <- rep(name.spdf, nrow(spdf))
>   }
> 
>   value <- vals[[quant]]
>   value <- pmax(pal.info$limits[1], pmin(pal.info$limits[2], value))
>   colours <- pal.info$palette(value)
> 
>   labels <- vapply(seq_len(nrow(spdf)), function(i) {
>     paste0(
>       "Region: ", region.names[i], "<br/>",
>       "Damages: ",
>       format_estimate_with_ci(vals$mu[i], vals$ci05[i], vals$ci95[i], quant)
>     )
>   }, character(1))
> 
>   styles <- lapply(seq_len(nrow(spdf)), function(i) {
>     list(fillColor = colours[i], label = labels[i])
>   })
>   names(styles) <- as.character(spdf$PID)
> 
>   list(styles = styles)
> }
> 
> getAllColors <- function(nn) {
