> server <- function(input, output, session) {
>   selected.feature <- reactiveVal(NULL)
>   rendered.channel <- reactiveVal(NULL)
> 
>   savedInvests <- reactiveValues(rows = data.frame(), pdf = data.frame())
>   adt.data <- reactiveValues(adt.input = NULL, risk.input = NULL)
> 
>   if (Sys.getenv("SHINY_PORT") == "") {
>     session$onSessionEnded(stopApp)
>   }
> 
>   map.state <- reactive({
>     list(
>       channel = input$channel,
>       scenario = ifelse(
>         input$scenario == "Most Likely - Expected annual damage",
>         "Most Likely", "High Risk"
>       ),
>       measure = ifelse(
>         input$scenario == "High Risk - Extreme year",
>         "Extreme", "EAD"
>       ),
>       quant = switch(
>         input$quant,
>         "1-in-20 less than" = "ci05",
>         "1-in-20 more than" = "ci95",
>         "mu"
>       ),
>       year = input$year[1]
>     )
>   }) |> debounce(100)
> 
>   output$outputsTable <- renderUI({
>     constructTableHTML(rbind(
>       data.frame(
>         Title = "Investing in Climate Resilience in the UK",
>         Type = "Policy Brief",
>         Released = "June 2026",
>         Links = as.character(tags$a(
>           "Brief", href = "www/PROSPER-UK-2026.pdf", target = "_blank"
>         ))
>       ),
>       data.frame(
>         Title = "New Insights on Physical Climate Risk and Adaptation Assessment",
>         Type = "Policy Brief",
>         Released = "July 2026",
>         Links = "In Preparation"
>       ),
>       data.frame(
>         Title = "Risks Estimates for the UK",
>         Type = "Dataset",
>         Released = "June 2026",
>         Links = as.character(tags$a(
>           "Archive", href = "https://zenodo.org/", target = "_blank"
>         ))
>       )
>     ))
>   })
> 
>   output$map1 <- renderLeaflet({
>     leaflet() %>%
>       addTiles() %>%
>       setView(lat = 54, lng = -3, zoom = 6)
>   })
> 
>   # Geometry is transmitted only when the channel changes.
>   observeEvent(input$channel, {
>     channel <- input$channel
>     spdf <- shape.cache[[channel]]
>     pal.info <- palette.cache[[channel]]
> 
>     proxy <- leafletProxy("map1", session) %>%
>       clearGroup("risk-polygons") %>%
>       clearControls() %>%
>       addPolygons(
>         data = spdf,
>         layerId = ~PID,
>         group = "risk-polygons",
>         fillColor = "transparent",
>         fillOpacity = .6,
>         color = "white",
>         weight = .3
>       ) %>%
>       addLegend(
>         pal = pal.info$palette,
>         values = rev(seq(pal.info$limits[1], pal.info$limits[2], length.out = 20)),
>         opacity = .5,
>         title = paste(channel, "<br/>", dataset2legend[[channel]]),
>         position = "topright"
>       )
> 
>     rendered.channel(channel)
> 
>     session$onFlushed(function() {
>       state <- map.state()
>       session$sendCustomMessage(
>         "updatePolygonStyles",
>         make_map_payload(
>           state$channel, state$scenario,
>           state$measure, state$year, state$quant
>         )
>       )
>     }, once = TRUE)
>   }, ignoreInit = FALSE)
> 
>   # Only colours and tooltip strings are sent for ordinary map updates.
>   observeEvent(map.state(), {
