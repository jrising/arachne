> # This handler changes styles/labels without re-sending sf geometry to Leaflet.
> leaflet_style_js <- "
> Shiny.addCustomMessageHandler('updatePolygonStyles', function(payload) {
>   var widget = HTMLWidgets.find('#map1');
>   if (!widget) return;
>   var map = widget.getMap();
>   if (!map) return;
> 
>   Object.keys(map._layers).forEach(function(key) {
>     var layer = map._layers[key];
>     if (!layer.options || layer.options.layerId === undefined) return;
> 
>     var id = String(layer.options.layerId);
>     var style = payload.styles[id];
>     if (!style) return;
> 
>     layer.setStyle({
>       fillColor: style.fillColor,
>       fillOpacity: 0.6,
>       color: 'white',
>       weight: 0.3
>     });
> 
>     if (layer.getTooltip()) {
>       layer.getTooltip().setContent(style.label);
>     } else {
>       layer.bindTooltip(style.label, {
>         sticky: true,
>         direction: 'auto',
>         className: 'map-tooltip'
>       });
>     }
>   });
> });
> "
> 
> JS.logify <- "
> function logifySlider(sliderId, sci = false) {
>   var slider = $('#' + sliderId).data('ionRangeSlider');
>   if (!slider) return;
>   slider.update({
>     prettify: function(num) {
>       return +(Math.pow(10, num).toPrecision(2));
>     }
>   });
> }
> "
> 
> JS.onload <- "
> $(document).ready(function() {
>   setTimeout(function() { logifySlider('investment'); }, 5);
> });
> "
