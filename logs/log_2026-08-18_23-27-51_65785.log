> # Your existing get.adaptgraph() and get.adaptgraph.with.prev() functions
> # should remain unchanged from the original script.
> get.adaptgraph.with.prev <- function(
>     adtchannel, adaptation, investment, risk.input, adt.input, savedInvestsPdf
> ) {
>   label <- adtchannel
> 
>   if (!(label %in% savedInvestsPdf$label)) {
>     return(get.adaptgraph(adtchannel, adaptation, investment, risk.input, adt.input))
>   }
> 
>   adaptgraph.prev <- savedInvestsPdf[savedInvestsPdf$label == label, -1:-2]
> 
>   pdf4 <- get.adaptgraph(
>     adtchannel, adaptation,
>     log10(10^investment - sum(adaptgraph.prev$benefits[
>       adaptgraph.prev$measure == "Invest" &
>         adaptgraph.prev$scenario == "Most Likely"
>     ])),
>     risk.input, adt.input
>   )
> 
>   pdf5 <- rbind(cbind(call = "curr", pdf4), cbind(call = "prev", adaptgraph.prev))
> 
>   pdf5 %>%
>     group_by(year, scenario, measure) %>%
>     summarize(
>       ci05 = ci05[call == "curr"] - sum(benefits[call == "prev"]),
>       ci95 = ci95[call == "curr"] - sum(benefits[call == "prev"]),
>       benefits = benefits[call == "curr"] - sum(benefits[call == "prev"]),
>       .groups = "drop"
>     )
> }
> 
> get.adaptgraph <- function(
>     adtchannel, adaptation, investment, risk.input, adt.input
> ) {
>   if (adtchannel == "Coastal impacts") {
>     pdf <- slr.adapt.prop(10^investment, adt.input)
>     pdf2 <- pdf %>%
>       left_join(risk.input, by = c("year", "segment"), suffix = c(".adt", "")) %>%
>       mutate(
>         benefits = mu * (1 - mu.adt),
>         ci05 = ci05 * (1 - ci75),
>         ci95 = ci95 * (1 - ci25)
>       ) %>%
>       group_by(year, scenario, measure) %>%
>       summarize(benefits = sum(benefits), ci05 = sum(ci05), ci95 = sum(ci95),
>                 .groups = "drop")
> 
>   } else if (adtchannel == "All-source flooding") {
>     pdf <- flood.adapt.prop(10^investment, adt.input)
>     pdf2 <- risk.input %>%
>       mutate(
>         benefits = mu * (1 - pdf$mu),
>         ci05 = ci05 * (1 - pdf$ci75),
>         ci95 = ci95 * (1 - pdf$ci25)
>       ) %>%
>       group_by(year, scenario, measure) %>%
>       summarize(benefits = sum(benefits), ci05 = sum(ci05), ci95 = sum(ci95),
>                 .groups = "drop")
> 
>   } else if (adtchannel == "Agricultural productivity") {
>     pdf <- agric.adapt.prop(10^investment, adt.input)
>     pdf2 <- risk.input %>%
>       left_join(pdf, by = c("scenario", "year", "measure", "county"),
>                 suffix = c("", ".adt")) %>%
>       mutate(
>         benefits = mu * (1 - mu.adt),
>         ci05 = ci05 * (1 - ci75),
>         ci95 = ci95 * (1 - ci25)
>       ) %>%
>       group_by(year, scenario, measure) %>%
>       summarize(benefits = sum(benefits), ci05 = sum(ci05), ci95 = sum(ci95),
>                 .groups = "drop")
> 
>   } else if (adtchannel == "Labour productivity & supply") {
>     pdf <- labor.adapt.prop(10^investment, adt.input)
>     pdf2 <- risk.input %>%
>       left_join(pdf, by = c("scenario", "year", "measure")) %>%
>       mutate(
>         benefits = ifelse(group == "Effort", mu * (1 - mu.effort), mu * (1 - mu.hours)),
>         ci05 = ifelse(group == "Effort", ci05 * (1 - ci75.effort), ci05 * (1 - ci75.hours)),
>         ci95 = ifelse(group == "Effort", ci95 * (1 - ci25.effort), ci95 * (1 - ci25.hours))
>       ) %>%
>       group_by(year, scenario, measure) %>%
>       summarize(benefits = sum(benefits), ci05 = sum(ci05), ci95 = sum(ci95),
>                 .groups = "drop")
> 
>   } else if (adtchannel == "Heat-related mortality") {
>     adapt.func <- list(
>       "Proportional to Benefits" = health.adapt.prop,
>       "Air Conditioning" = health.adapt.aircon,
>       "Shutters" = health.adapt.shutters
>     )[[adaptation]]
> 
>     pdf <- adapt.func(10^investment, adt.input)
>     pdf2 <- risk.input %>%
>       left_join(pdf, by = c("scenario", "year", "measure"),
>                 suffix = c("", ".adt")) %>%
>       mutate(
>         benefits = mu * (1 - mu.adt),
>         ci05 = ci05 * (1 - ci75),
>         ci95 = ci95 * (1 - ci25)
>       ) %>%
>       group_by(year, scenario, measure) %>%
>       summarize(benefits = sum(benefits), ci05 = sum(ci05), ci95 = sum(ci95),
>                 .groups = "drop")
>   }
> 
>   pdf3 <- pdf2 %>%
>     left_join(filter(pdf2, year == 2025), by = "scenario",
>               suffix = c("", ".2025")) %>%
>     mutate(
>       benefits = ifelse(benefits.2025 < 0, benefits - benefits.2025, benefits),
>       ci05 = ifelse(benefits.2025 < 0, ci05 - benefits.2025, ci05),
>       ci95 = ifelse(benefits.2025 < 0, ci95 - benefits.2025, ci95)
>     )
> 
>   rbind(
>     data.frame(
>       year = 2025,
>       scenario = c("High Risk", "Most Likely"),
>       measure = "Invest",
>       benefits = -10^investment,
>       ci05 = NA, ci95 = NA
>     ),
>     pdf3[, c("year", "scenario", "measure", "benefits", "ci05", "ci95")]
>   )
> }
