> 
> function make_pool_context()
>     tickers = String.(names(highpricesdf))
>     current = Dict(tickers .=> getcurrprices())
>     growstd = Dict(tickers .=> getgrowstddev())
> 
>     return Dict(
>         "created_at" => string(now()),
>         "tickers" => tickers,
>         "current_prices" => current,
>         "grow_stddev" => growstd,
