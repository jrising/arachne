> # OpenAI-backed memory model skeleton
> 
> Now let’s define the real implementation seam, without overcommitting to prompt details yet.
> 
> ## `model_openai.py`
> 
> ```python
> class OpenAIMemoryModel:
>     def __init__(
>         self,
>         client: Any,
>         *,
>         model_name: str,
>         temperature: float = 0.0,
>     ) -> None:
>         self.client = client
>         self.model_name = model_name
>         self.temperature = temperature
> 
>     def summarize_conversation(
>         self,
>         transcript: ConversationTranscript,
>         existing_summary: Optional[str] = None,
>     ) -> str:
>         raise NotImplementedError
> 
>     def summarize_turn_delta(
>         self,
>         transcript: ConversationTranscript,
>         previous_state: ConversationState,
>     ) -> ConversationState:
>         raise NotImplementedError
> 
>     def build_retrieval_query(
>         self,
>         recent_messages: Sequence[Message],
>         conversation_state: ConversationState,
>     ) -> str:
>         raise NotImplementedError
> 
>     def extract_candidate_memories(
>         self,
>         transcript: ConversationTranscript,
>         conversation_summary: str,
>     ) -> list[MemoryRecord]:
>         raise NotImplementedError
> 
>     def merge_profile(
>         self,
>         existing_profile: Optional[UserProfile],
>         candidate_memories: Sequence[MemoryRecord],
>     ) -> UserProfile:
>         raise NotImplementedError
> 
>     def build_prompt_memory_block(
>         self,
>         profile: Optional[UserProfile],
>         memories: Sequence[MemoryRecord],
>         tasks: Sequence[TaskRecord],
>         conversation_state: ConversationState,
>     ) -> str:
>         """
>         This one can be deterministic and not require an LLM.
>         """
>         lines: list[str] = []
> 
>         if profile or memories or tasks or conversation_state.running_summary:
>             lines.append("Long-term and conversation memory:")
> 
>         if profile:
>             if profile.facts:
>                 lines.append("Known facts about user:")
>                 for fact in profile.facts[:8]:
>                     lines.append(f"- {fact}")
>             if profile.preferences:
>                 lines.append("User preferences:")
>                 for pref in profile.preferences[:8]:
>                     lines.append(f"- {pref}")
> 
>         if tasks:
>             lines.append("Active tasks:")
>             for task in tasks[:8]:
>                 title = task.title
>                 if task.current_step:
>                     title += f" | next: {task.current_step}"
>                 lines.append(f"- [{task.status}] {title}")
> 
>         if conversation_state.current_goals:
>             lines.append("Current conversation goals:")
>             for goal in conversation_state.current_goals[-5:]:
>                 lines.append(f"- {goal}")
> 
>         if conversation_state.constraints:
>             lines.append("Current constraints:")
>             for constraint in conversation_state.constraints[-5:]:
>                 lines.append(f"- {constraint}")
> 
>         if memories:
>             lines.append("Relevant prior memory:")
>             for memory in memories[:8]:
>                 text = memory.summary or memory.content[:200]
>                 lines.append(f"- ({memory.kind}) {text}")
> 
>         return "\n".join(lines)
> ```
> 
> For the real implementation, I’d recommend that:
> - `build_prompt_memory_block` be deterministic
> - the LLM only be used for:
>   - summarization
>   - extraction
>   - maybe retrieval-query generation
>   - maybe profile merge if you want nuance
> 
> That reduces cost and weirdness.
> 
