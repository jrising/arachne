> class ExecutionRun:
>     """
>     One execution of an LLM-authored JavaScript plan.
> 
>     Runs form a parent/child tree. Detailed tool/model-call records should be
>     stored as artifacts or events and reference this run ID.
>     """
> 
>     id: str
>     response_id: str
>     parent_run_id: str | None
>     source: str
>     started_at: float
>     status: ExecutionRunStatus = "pending"
>     completed_at: float | None = None
> 
>     # Persisted input and enforcement configuration for reproducibility.
>     input: Mapping[str, Any] = field(default_factory=dict)
>     limits: Mapping[str, Any] = field(default_factory=dict)
>     validation_passed: bool = False
> 
>     # JSON-safe final value, if any.
>     result: Any = None
>     error: str | None = None
> 
>     # E.g. logical call location, model ID, worker version, aggregate usage.
>     metadata: Mapping[str, Any] = field(default_factory=dict)
>     
>     depth: int = 0
>     logical_call_location: str | None = None
>     plan_source: str | None = None
>     plan_api_version: str | None = None
