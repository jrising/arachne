**assistant**:
> Yes. `llm_smart` should execute the generated plan synchronously as a **child `ExecutionRun`**. The essential safeguards are a depth limit, bounded child plan limits, and durable parent/child attribution.
> 
> Below is a revised `planner/tools/llm.py` core. It assumes the `ModelRouter` proposed earlier.
> 
> ```python
> from __future__ import annotations
> 
> import time
> import uuid
> from typing import Any, Mapping
> 
> from ..javascript.api import javascript_prompt
> from ..javascript.runtime import (
>     JavaScriptExecutionContext,
>     JavaScriptRuntime,
>     extract_plan,
> )
> from ..model_router import ModelRouter
> from ..persistence import PlannerRepository
> from ..registry import Registry
> from ..types import (
>     Artifact, ExecutionRun, JavaScriptPlan, Provenance,
>     ToolConfig, ToolInvocation, ToolResult,
> )
> from .base import Tool
> 
> _ROUTER_KEYS = {
>     "model_id", "model_version", "min_quality", "max_latency_s",
>     "max_cost_usd", "required_capabilities", "allow_fallback", "purpose",
> }
> _SMART_KEYS = {
>     *_ROUTER_KEYS,
>     "max_tokens",
>     "system_instructions",
>     "max_recursion_depth",
>     "max_operations",
>     "max_parallelism",
>     "max_wall_time_s",
>     "max_loop_iterations",
>     "max_output_bytes",
> }
> 
> 
> def _settings(invocation: ToolInvocation, allowed: set[str]) -> dict[str, Any]:
>     settings = dict(invocation.config)
>     settings.update({
>         key: value for key, value in invocation.arguments.items()
>         if key in allowed
>     })
>     return settings
> 
> 
> def _messages(
>     invocation: ToolInvocation,
>     settings: Mapping[str, Any],
> ) -> list[dict[str, str]]:
>     prompt = invocation.arguments.get("prompt")
>     if not isinstance(prompt, str) or not prompt.strip():
>         raise ValueError("Expected a non-empty `prompt` argument.")
> 
>     messages = []
>     instructions = settings.get("system_instructions")
>     if instructions:
>         if not isinstance(instructions, str):
>             raise ValueError("system_instructions must be a string.")
>         messages.append({"role": "system", "content": instructions})
>     messages.append({"role": "user", "content": prompt})
>     return messages
> 
> 
> def _provenance(invocation: ToolInvocation, model_id: str, version: str) -> Provenance:
>     return Provenance(
>         source_kind="model",
>         source_id=model_id,
>         source_version=version,
>         operation_id=invocation.operation_id,
>         retrieved_at=time.time(),
>         trust_level="untrusted",
>     )
> 
> 
> def make_llm_smart_tool(
>     router: ModelRouter,
>     registry: Registry,
>     repository: PlannerRepository,
>     runtime: JavaScriptRuntime,
>     *,
>     version: str = "1",
> ) -> Tool:
>     """
>     Invoke a routed LLM, extract an optional terminal JS plan, and execute it
>     as a bounded child execution run.
> 
>     This must be called with provenance_requirements.execution_run_id and
>     .response_id when invoked from JavaScriptRuntime.
>     """
> 
>     def invoke(invocation: ToolInvocation) -> ToolResult:
>         settings = _settings(invocation, _SMART_KEYS)
>         max_tokens = settings.pop("max_tokens", None)
> 
>         parent_run_id = invocation.provenance_requirements.get("execution_run_id")
>         response_id = invocation.provenance_requirements.get("response_id")
> 
>         if not isinstance(parent_run_id, str) or not isinstance(response_id, str):
>             raise ValueError(
