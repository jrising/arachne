> MAX_SOURCE_CHARS = 20_000
> FORBIDDEN = re.compile(
>     r"\b(import|export|require|eval|Function|WebAssembly|"
>     r"process|globalThis|Deno|Bun|fetch|XMLHttpRequest|"
>     r"setTimeout|setInterval|while|do)\b"
> )
> 
> def validate(source: str) -> None:
>     if len(source) > MAX_SOURCE_CHARS:
