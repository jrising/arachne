> class InMemoryRepository:
>     """
>     Thread-safe development implementation.
> 
>     Returned records and values are deep-copied so callers cannot mutate
>     repository state without an explicit repository write.
>     """
> 
>     def __init__(self) -> None:
>         self._lock = RLock()
> 
>         self._response_records: dict[str, ResponseRecord] = {}
>         self._execution_runs: dict[str, ExecutionRun] = {}
>         self._execution_run_ids_by_response: dict[str, list[str]] = defaultdict(list)
>         
>         self._feedback: list[FeedbackEvent] = []
> 
>         self._events_by_conversation: dict[str, list[Event]] = defaultdict(list)
>         self._state: dict[tuple[str, str], dict[str, Any]] = {}
> 
>         self._artifacts: dict[str, Artifact] = {}
>         self._artifact_ids_by_conversation: dict[str, list[str]] = defaultdict(list)
> 
>         self._operations: dict[str, Operation] = {}
> 
>         self._tool_call_traces: dict[str, ToolCallTrace] = {}
>         self._trace_ids_by_run: dict[str, list[str]] = defaultdict(list)
> 
>     def save_response_record(self, record: ResponseRecord) -> None:
>         with self._lock:
>             self._response_records[record.response_id] = deepcopy(record)
> 
>     def get_response_record(self, response_id: str) -> ResponseRecord | None:
