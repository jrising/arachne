> class ToolUseResponder(LLMResponder):
>     """
>     Execute predeclared bound tools, then invoke the model with safe excerpts.
> 
>     This is intentionally a constrained v1 mechanism, not an arbitrary
>     model-directed serial tool loop. Tool arguments are supplied through
>     ``context.metadata["tool_arguments"]`` keyed by tool name.
>     """
>     def __init__(self, *, artifact_sink=None, **kwargs) -> None:
>         super().__init__(**kwargs)
>         self.artifact_sink = artifact_sink
> 
>     def _run_tools(
>         self,
>         plan: PlanSpec,
>         context: PlannerContext,
>         registry: "Registry",
>         operation_prefix: str,
>     ) -> list[ToolResult]:
>         configured_args = context.metadata.get("tool_arguments", {})
>         if not isinstance(configured_args, Mapping):
>             raise TypeError("context.metadata['tool_arguments'] must be a mapping.")
> 
>         results: list[ToolResult] = []
>         for index, binding in enumerate(plan.tool_bindings):
>             tool = registry.get_tool(binding.tool_name, binding.tool_version)
>             invocation = ToolInvocation(
>                 operation_id=f"{operation_prefix}:tool:{index}",
>                 conversation_id=str(context.metadata.get("conversation_id", "")),
>                 arguments=self._default_tool_arguments(context, binding.tool_name),
>                 config=dict(binding.config),
>                 context=context,
>             )
>             result = tool.fn(invocation)
>             if not isinstance(result, ToolResult):
>                 raise TypeError(
>                     f"Tool {binding.tool_name!r} returned {type(result).__name__}; "
>                     "registered tools must return ToolResult."
>                 )
>             if result.metadata.get("ok") is False:
>                 raise RuntimeError(
>                     f"Tool {binding.tool_name!r} failed: "
>                     f"{result.metadata.get('error_code', 'unknown_error')}"
>                 )
>             if self.artifact_sink:
>                 for artifact in result.artifacts:
>                     self.artifact_sink(artifact)            
>             results.append(result)
> 
>         for result in results:
>             print(
>                 "tool:", result.metadata,
>                 "artifacts:", len(result.artifacts),
>                 "excerpts:", len(result.source_excerpts),
>             )
> 
>         return results
> 
>     @staticmethod
>     def _default_tool_arguments(
>         context: PlannerContext,
>         tool_name: str,
>     ) -> dict[str, Any]:
>         configured = context.metadata.get("tool_arguments", {})
>         if isinstance(configured, Mapping) and tool_name in configured:
>             return dict(configured[tool_name])
>         if tool_name == "openai_web_search":
>             for message in reversed(context.metadata.get("messages", ())):
>                 if message.get("role") == "user" and isinstance(message.get("content"), str):
>                     return {"query": message["content"]}
>         return {}
> 
>     def _messages_with_tool_results(
>         self,
>         plan: PlanSpec,
