>                 "child_run_id": child.id,
>                 "result": result,
>             },
>             raw_output=raw_text,
>         )
> 
>     return Tool(
>         name="llm_smart",
>         description="Ask an LLM for an answer and execute its bounded recursive JavaScript plan.",
>         fn=invoke,
