>             )
> 
>         parent = repository.get_execution_run(parent_run_id)
>         if parent is None:
>             raise KeyError(f"Unknown parent execution run: {parent_run_id!r}")
> 
>         max_depth = int(settings.get("max_recursion_depth", 2))
>         child_depth = parent.depth + 1
>         if child_depth > max_depth:
>             raise RuntimeError(
