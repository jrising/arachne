>         )
>         raw_text = resolved.adapter.chat_response(messages, max_tokens=max_tokens)
>         visible_text, generated_plan = extract_plan(raw_text)
> 
>         provenance = _provenance(
>             invocation, resolved.model_id, resolved.version
>         )
>         artifacts = [
>             Artifact(
>                 id=str(uuid.uuid4()),
>                 conversation_id=invocation.conversation_id,
>                 kind="llm_response",
>                 content=visible_text,
>                 media_type="text/plain",
>                 provenance=provenance,
>                 created_at=time.time(),
>                 metadata={
>                     "model_id": resolved.model_id,
>                     "model_version": resolved.version,
>                     "model_resolution": dict(resolved.decision),
>                 },
>             )
>         ]
> 
>         if generated_plan is None:
>             return ToolResult(
>                 artifacts=artifacts,
>                 metadata={"ok": True, "text": visible_text, "has_plan": False},
>                 raw_output=raw_text,
>             )
> 
>         # Never accept model-selected resource limits. The host sets them.
>         child_plan = JavaScriptPlan(
>             source=generated_plan.source,
>             api_version=generated_plan.api_version,
>             max_operations=min(int(settings.get("max_operations", 24)), 24),
>             max_parallelism=min(int(settings.get("max_parallelism", 4)), 4),
>             max_wall_time_s=min(int(settings.get("max_wall_time_s", 45)), 45),
>             max_loop_iterations=min(
>                 int(settings.get("max_loop_iterations", 15)), 15
>             ),
>             max_output_bytes=min(
>                 int(settings.get("max_output_bytes", 250_000)), 250_000
>             ),
>         )
> 
>         child = ExecutionRun(
>             id=str(uuid.uuid4()),
>             response_id=response_id,
>             parent_run_id=parent.id,
>             source="llm_smart",
>             started_at=time.time(),
>             status="pending",
>             input={
>                 "prompt": invocation.arguments["prompt"],
>                 "visible_text": visible_text,
>                 "parent_run_id": parent.id,
>             },
>             limits={
>                 "max_recursion_depth": max_depth,
>                 "max_operations": child_plan.max_operations,
>                 "max_wall_time_s": child_plan.max_wall_time_s,
>             },
>             validation_passed=True,
>             depth=child_depth,
>             logical_call_location=invocation.operation_id,
>             plan_source=child_plan.source,
