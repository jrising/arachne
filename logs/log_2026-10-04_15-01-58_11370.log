>     if not re.search(r"async\s+function\s+main\s*\(\s*input\s*\)", source):
>         raise ValueError("Plan must define async function main(input).")
>     if FORBIDDEN.search(source):
>         raise ValueError("Plan contains a forbidden capability.")
