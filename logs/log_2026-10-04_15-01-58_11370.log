> @dataclass
> class ToolResult:
>     """
>     Normalized tool result.
> 
>     `raw_output` is optional transient diagnostic material. It should be stored
>     separately with retention controls, never injected blindly into prompts.
>     """
> 
>     artifacts: list[Artifact] = field(default_factory=list)
>     source_excerpts: list[SourceExcerpt] = field(default_factory=list)
>     state_patches: list[StatePatch] = field(default_factory=list)
