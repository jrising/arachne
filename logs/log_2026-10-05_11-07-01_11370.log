> def javascript_tools(registry: Registry) -> list[dict[str, Any]]:
>     """Return explicitly JS-exposed, version-pinned registered tools."""
>     tools: list[dict[str, Any]] = []
>     seen: set[str] = set()
> 
>     for spec in registry.list_tools():
>         js = spec.metadata.get("javascript") if spec.metadata else None
>         if not isinstance(js, Mapping) or not isinstance(js.get("name"), str):
>             continue
> 
>         name = js["name"]
>         if not _JS_NAME.fullmatch(name):
>             raise ValueError(f"Invalid JavaScript tool name: {name!r}")
>         if name in seen:
>             raise ValueError(f"Duplicate JavaScript tool name: {name!r}")
>         seen.add(name)
> 
>         tools.append({
>             "name": name,
>             "description": spec.description,
>             "arguments": dict(js.get("arguments", {})),
>             "returns": js.get("returns", "json"),
>             "tool_name": spec.name,
>             "tool_version": spec.version,
>         })
> 
>     return sorted(tools, key=lambda tool: tool["name"])
