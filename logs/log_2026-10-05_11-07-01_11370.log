> class LLMResponder(BaseResponder):
>     """Direct execution through a registered model adapter."""
> 
>     def chat_response(
>         self,
>         plan: PlanSpec,
>         context: PlannerContext,
>         registry: "Registry",
>         *,
>         record: ResponseRecord,
>         max_tokens: int | None = None,
>     ) -> Response:
>         if plan.model_id is None:
>             raise ValueError("LLMResponder requires a plan with model_id.")
> 
>         model = registry.get_model(plan.model_id, plan.model_version)
>         messages = self.message_builder(plan, context)
> 
>         metrics = MetricsTracker(record)
>         metrics.add_model_call()
>         
>         try:
>             text = model.adapter.chat_response(messages, max_tokens=max_tokens)
>             research_plan = None
>             if plan.template_id == "direct_with_plan":
>                 text, research_plan = _split_research_plan(text)
> 
>             self._finish_record(record, text=text)
>             metrics.add_estimated_cost(self._estimated_model_cost(registry, plan, record))
>             return Response(id=record.response_id, text=text,
>                             model=plan.model_id, research_plan=research_plan)
>         except Exception as exc:
>             self._finish_record(record, error=exc)
>             raise ResponderExecutionError("Model response failed.", record) from exc
> 
>     def stream_response(
>         self,
>         plan: PlanSpec,
>         context: PlannerContext,
>         registry: "Registry",
>         *,
>         record: ResponseRecord,
>         max_tokens: int | None = None,
>     ) -> StreamResponse:
>         if plan.model_id is None:
>             raise ValueError("LLMResponder requires a plan with model_id.")
> 
>         # The record exists before the first visible chunk is yielded.
>         model = registry.get_model(plan.model_id, plan.model_version)
>         messages = self.message_builder(plan, context)
> 
>         metrics = MetricsTracker(record)
>         metrics.add_model_call()
> 
>         def chunks() -> Iterator[str]:
>             emitted: list[str] = []
>             try:
>                 for chunk in model.adapter.stream_response(messages, max_tokens=max_tokens):
>                     if chunk:
>                         if not record.visible_output_started:
>                             metrics.mark_visible_output_started()
>                         emitted.append(chunk)
>                         yield chunk
> 
>                 self._finish_record(record, text="".join(emitted))
>             except Exception as exc:
>                 self._finish_record(record, error=exc)
>                 # Planner must persist `record`; it must not retry if output began.
>                 raise ResponderExecutionError("Model stream failed.", record) from exc
> 
>         return StreamResponse(id=record.response_id, chunks=chunks(), model=plan.model_id)
