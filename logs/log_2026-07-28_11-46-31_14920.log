>                 tmean_vals = da_tm["tmean"].values
> 
>                 # average across region/time if multiple matches
>                 if tp_vals.size > 0:
>                     result["tp"] = float(np.nanmean(tp_vals))
>                 if tmean_vals.size > 0:
>                     result["tmean"] = float(np.nanmean(tmean_vals))
>         except Exception:
>             # silently ignore and keep NaNs
>             pass
> 
>     # --- 3.2 runoff: rainfall, era5melt, tempmelt ---
>     if ds_runoff is not None:
>         try:
