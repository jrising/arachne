>                 t_vals = da_tm["tempmelt"].values
> 
>                 if r_vals.size > 0:
>                     result["rainfall"] = float(np.nanmean(r_vals))
>                 if e_vals.size > 0:
>                     result["era5melt"] = float(np.nanmean(e_vals))
>                 if t_vals.size > 0:
>                     result["tempmelt"] = float(np.nanmean(t_vals))
>         except Exception:
>             pass
> 
