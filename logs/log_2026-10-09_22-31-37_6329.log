>             parent_run_id=None,
>             source="planner_model",
>             started_at=time.time(),
>             status="pending",
>             input={
>                 "visible_text": visible_text,
>                 "response_id": record.response_id,
>                 "conversation_id": record.conversation_id,
>             },
>             limits={
>                 "max_operations": javascript_plan.max_operations,
>                 "max_parallelism": javascript_plan.max_parallelism,
>                 "max_wall_time_s": javascript_plan.max_wall_time_s,
>                 "max_loop_iterations": javascript_plan.max_loop_iterations,
>                 "max_output_bytes": javascript_plan.max_output_bytes,
>             },
>             validation_passed=True,  # extract_plan() calls validate().
>             depth=0,
>             plan_source=javascript_plan.source,
>             plan_api_version=javascript_plan.api_version,
