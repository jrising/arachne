>         self.repository.save_execution_run(run)
> 
>         if run.id not in record.execution_run_ids:
>             record.execution_run_ids.append(run.id)
> 
>         # Persist attribution before execution, including failures.
>         self.repository.save_response_record(record)
> 
>         try:
>             result = self.runtime.execute(
>                 javascript_plan,
