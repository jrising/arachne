# planner/tools/llm_text.py
"""
Bounded registered LLM-generation tool.

This tool generates text as untrusted data. It does not execute returned
JavaScript plans; RegistryToolExecutor / RecursivePlanCoordinator own that
policy and may inspect metadata["value"]["text"] after this tool returns.

Model choice is injected through ``resolve_model_id``. This keeps the tool
compatible with the Planner's registered-model selection policy rather than
embedding a provider-specific model-routing policy here.
"""

from __future__ import annotations

import time
import uuid
from typing import Any, Callable, Mapping, Protocol

from ..types import Artifact, Provenance, ToolInvocation, ToolResult

MAX_PROMPT_CHARS = 32_000
DEFAULT_MAX_TOKENS = 600
MAX_MAX_TOKENS = 4_096


class ModelResolver(Protocol):
    """
    Resolve an explicitly requested model, or select an ordinary eligible
    registered model when requested_model_id is None.

    Implementations should reject unknown/disallowed models.
    """

    def __call__(
        self,
        invocation: ToolInvocation,
        requested_model_id: str | None,
    ) -> str: ...


def build_llm_text_tool(
    client: Any,
    *,
    resolve_model_id: ModelResolver,
    default_max_tokens: int = DEFAULT_MAX_TOKENS,
    max_tokens_limit: int = MAX_MAX_TOKENS,
) -> Callable[[ToolInvocation], ToolResult]:
